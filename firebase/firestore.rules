rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function guest() { return request.auth != null; }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function validComment(d, id) {
      return d.keys().hasOnly(['id','ownerUid','author','text','anchor','createdAt','updatedAt','resolved','resolvedBy','resolvedAt'])
        && d.id == id && text(d.ownerUid,128) && text(d.author,100) && text(d.text,8000)
        && text(d.createdAt,40) && text(d.updatedAt,40) && d.resolved is bool
        && d.anchor is map && d.anchor.keys().hasOnly(['selector','offsetX','offsetY','viewportX','viewportY'])
        && d.anchor.selector is string && d.anchor.selector.size() <= 2000
        && d.anchor.offsetX is number && d.anchor.offsetY is number
        && d.anchor.viewportX is number && d.anchor.viewportY is number
        && d.resolvedBy is string && d.resolvedBy.size() <= 100
        && d.resolvedAt is string && d.resolvedAt.size() <= 40;
    }
    function validReply(d, id) {
      return d.keys().hasOnly(['id','commentId','ownerUid','author','text','createdAt','updatedAt'])
        && d.id == id && text(d.commentId,100) && text(d.ownerUid,128)
        && text(d.author,100) && text(d.text,8000)
        && text(d.createdAt,40) && text(d.updatedAt,40);
    }
    match /pages/{page}/comments/{id} {
      allow read: if guest();
      allow create: if guest() && validComment(request.resource.data,id)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if guest() && validComment(request.resource.data,id)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.ownerUid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved','resolvedBy','resolvedAt','updatedAt']));
      allow delete: if guest() && resource.data.ownerUid == request.auth.uid;
    }
    match /pages/{page}/replies/{id} {
      allow read: if guest();
      allow create: if guest() && validReply(request.resource.data,id)
        && request.resource.data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/pages/$(page)/comments/$(request.resource.data.commentId));
      allow update: if guest() && validReply(request.resource.data,id)
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','updatedAt']);
      allow delete: if guest() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
