---
import type { GetStaticPaths } from 'astro';
import Guide from '../../../layouts/Guide.astro';
import SkillCard from '../../../components/SkillCard.astro';
import { skills, type BrandSkill } from '../../../data/skills';
import { withBase } from '../../../data/base';

export const getStaticPaths = (() => skills.map((skill) => ({
  params: { skill: skill.slug }, props: { skill },
}))) satisfies GetStaticPaths;

interface Props { skill: BrandSkill }
const { skill } = Astro.props;
---

<Guide slug="skills" pageTitle={skill.title} hero={false} description={skill.description}>
  <div class="skill-page">
    <header class="skill-header">
      <a class="back" href={withBase('/skills/')}>← Skills</a>
      <h1 class="display">{skill.title}</h1>
      <p class="muted">{skill.summary}</p>
    </header>
    <SkillCard skill={skill} />
  </div>
</Guide>

<style>
  .skill-page { max-width: 60rem; }
  .skill-header { display: grid; gap: 1rem; margin-bottom: 2rem; }
  .back { justify-self: start; margin-bottom: 0.5rem; color: var(--muted); }
</style>
