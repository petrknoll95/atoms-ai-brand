---
import type { GetStaticPaths } from 'astro';
import Guide from '../../../layouts/Guide.astro';
import SkillCard from '../../../components/SkillCard.astro';
import { skills, type BrandSkill } from '../../../data/skills';
import { sectionNumber } from '../../../data/nav';

export const getStaticPaths = (() => skills.map((skill) => ({
  params: { skill: skill.slug }, props: { skill },
}))) satisfies GetStaticPaths;

interface Props { skill: BrandSkill }
const { skill } = Astro.props;
// Skills is a numbered section; each skill page is numbered within it (11.1, 11.2).
const number = `${sectionNumber('skills')}.${skills.findIndex((s) => s.slug === skill.slug) + 1}`;
---

<Guide slug="skills" pageTitle={skill.title} number={number} description={skill.description}>
  <SkillCard skill={skill} />
</Guide>
