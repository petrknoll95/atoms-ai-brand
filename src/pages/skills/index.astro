---
import Guide from '../../layouts/Guide.astro';
import SkillArtwork from '../../components/SkillArtwork.astro';
import { skills } from '../../data/skills';
import { icon } from '../../data/icons';
import { withBase } from '../../data/base';
---

<Guide slug="skills" hero={false} description="Browse AtomsAI skills for brand consistency and SVG icon creation.">
  <header class="library-header">
    <h1 class="display">Skills</h1>
    <a class="btn" href={withBase('/skills/atomsai-skills.zip')} download="atomsai-skills.zip">Download both .zip ↓</a>
  </header>
  <div class="library">
    {skills.map((skill) => (
      <a class="library-item" href={skill.href} aria-labelledby={`${skill.slug}-title`}>
        <SkillArtwork slug={skill.slug} />
        <div class="item-body">
          <div class="item-heading">
            <h2 class="display" id={`${skill.slug}-title`}>{skill.title}</h2>
            <span class="arrow" set:html={icon('arrow-northeast')} aria-hidden="true" />
          </div>
          <p class="muted">{skill.summary}</p>
        </div>
      </a>
    ))}
  </div>
</Guide>

<style>
  .library-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 2rem; }
  .library { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .library-item { border: 1px solid var(--rule); color: var(--fg); text-decoration: none; min-width: 0; }
  .library-item:hover { border-color: var(--fg); }
  .item-body { padding: 1.5rem; display: grid; gap: 1rem; }
  .item-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .arrow { width: 1.5rem; flex: none; }
  .arrow :global(svg) { display: block; width: 100%; height: auto; }
  @media (max-width: 1100px) { .library { grid-template-columns: minmax(0, 1fr); } }
</style>
