---
import { withBase } from '../data/base';
import Guide from '../layouts/Guide.astro';
import Sub from '../components/Sub.astro';
import Figure from '../components/Figure.astro';
import { cmykCopy, cmykFor, printMatch, printProfiles, printReference, printStocks, printValues } from '../data/printColors';
import Swatch from '../components/Swatch.astro';
import ColorCombination from '../components/ColorCombination.astro';
import {
  allColors,
  bare,
  colors,
  combinations,
  contrast,
  gradientCss,
  gradients,
  overview,
  ramps,
  rgb,
  roles,
  themes,
  tokensCss,
  wcag,
  type ColorKey,
} from '../data/colors';


const roleBlocks = [
  { id: 'primary', title: 'Primary', number: '3.2', ...roles.primary },
  { id: 'secondary', title: 'Secondary', number: '3.3', ...roles.secondary },
  { id: 'accent', title: 'Accent', number: '3.4', ...roles.accent },
];

const rgbString = (hex: string) => rgb(hex).join(' ');
const ink = (key: ColorKey) =>
  contrast(colors[key].hex, colors.deepGreen.hex) >= contrast(colors[key].hex, colors.cream.hex)
    ? colors.deepGreen.hex
    : colors.cream.hex;
---

<Guide slug="color" description="The AtomsAI palette: copy any color, gradient or theme.">
  <Sub id="palette" title="Palette" number="3.1">
    <Fragment slot="text">
      <p>A forest-led palette. Deep green grounds the brand, cream gives it air, with purple and orange accents adding emphasis.</p>
      <p class="muted">Open the menu on any color to copy its HEX, RGB, CMYK, PANTONE or CSS value.</p>
      <div class="btn-row">
        <button class="btn" type="button" data-copy={tokensCss()} data-copy-message="CSS variables copied">Copy CSS variables</button>
        <a class="btn" href={withBase('/tokens.css')} download="atomsai-colors.css">Download .css</a>
      </div>
    </Fragment>
    <div class="mosaic">
      {
        overview.map((column) => (
          <div class="mosaic-col">
            {column.map(({ key, weight }) => (
              <Swatch color={key} style={` flex: ${weight} 1 0;`} />
            ))}
          </div>
        ))
      }
    </div>
  </Sub>

  {
    roleBlocks.map((block) => (
      <Sub id={block.id} title={block.title} number={block.number}>
        <Fragment slot="text">
          <p>{block.intro}</p>
          <p class="muted">Print values: C = coated, U = uncoated. <a href="#pantone">Profiles and proofing guidance ↓</a></p>
          {block.id === 'accent' && <p class="muted">Use Black labels on Iris and Orange CTAs. Pair Iris Light with Iris Dark ({contrast(colors.irisLight.hex, colors.irisDark.hex).toFixed(1)}:1), and Apricot with Crimson ({contrast(colors.apricot.hex, colors.crimson.hex).toFixed(1)}:1). Keep focal accents near 10% of a Forest-led layout.</p>}
        </Fragment>
        <div class="roles" style={`--count: ${Math.min(block.keys.length, 3)}`}>
          {block.keys.map((key) => {
            const c = colors[key];
            const [r, g, b] = rgb(c.hex);
            const values = [
              { label: 'HEX', shown: bare(c.hex), copy: c.hex },
              { label: 'RGB', shown: rgbString(c.hex), copy: `rgb(${r}, ${g}, ${b})` },
              ...printValues(c),
              { label: 'CSS', shown: `--${c.token}`, copy: `var(--${c.token})` },
            ];
            return (
              <div class="role">
                <Swatch color={key} class="role-chip" />
                <dl class="specs">
                  {values.map((v) => (
                    <div>
                      <dt class="muted">{v.label}</dt>
                      <dd>
                        <button type="button" class="value" title={'title' in v ? v.title : undefined} data-copy={v.copy} data-copy-message={`${c.name} ${v.label} copied`}>
                          {v.shown}
                        </button>
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            );
          })}
        </div>
      </Sub>
    ))
  }

  <Sub id="accent-stacking" title="Accent stacking" number="3.4.1">
    <Fragment slot="text">
      <p>Stack dark, mid and light tones within one family. Keep layers opaque and edges clean. Keep the lightest layer on top.</p>
    </Fragment>
    <Figure tone="plain" caption="Iris Dark · Iris · Iris Light / Crimson · Orange · Apricot">
      <div class="accent-stacking" role="img" aria-label="Two overlapping color stacks on black. Iris Dark, Iris and Iris Light align along the bottom. Crimson, Orange and Apricot step upwards.">
        <div class="accent-stacking-art">
        <span class="stack-iris-dark"></span><span class="stack-iris"></span><span class="stack-iris-light"></span>
        <span class="stack-crimson"></span><span class="stack-orange"></span><span class="stack-apricot"></span>
        </div>
      </div>
    </Figure>
  </Sub>

  <Sub id="shades" title="Shades" number="3.5">
    <Fragment slot="text">
      <p>Forest – Cream. Seven steps from forest shade to cream. Use the ramp for hierarchy, interface states and data visualization.</p>
    </Fragment>
    <div class="ramp">
      {ramps.shades.map((key) => <Swatch color={key} />)}
    </div>
  </Sub>

  <Sub id="neutrals" title="Neutrals" number="3.6">
    <Fragment slot="text">
      <p>Forest shade to Paper. Use these green-tinted neutrals for brand surfaces and editorial layouts.</p>
    </Fragment>
    <div class="ramp">
      {ramps.neutrals.map((key) => <Swatch color={key} />)}
    </div>
  </Sub>

  <Sub id="true-greys" title="True greys" number="3.6.1">
    <Fragment slot="text">
      <p>Black to White in seven steps. Use dark greys for labels, light greys for dividers and surfaces, and the full scale for ordered data.</p>
    </Fragment>
    <div class="ramp">
      {ramps.trueGreys.map((key) => <Swatch color={key} />)}
    </div>
  </Sub>

  <Sub id="combinations" title="Combinations" number="3.7">
    <Fragment slot="text">
      <p>Lead with one color, support with a second and accent with a third. Click any shape to copy its HEX value.</p>
    </Fragment>
    <div class="combos">
      {combinations.map((palette, i) => <ColorCombination palette={palette} variant={i} />)}
    </div>
  </Sub>

  <Sub id="gradients" title="Gradients" number="3.8">
    <Fragment slot="text">
      <p>Soft vertical blends built only from palette colors. Use them as quiet backgrounds or as the base field for patterns.</p>
      <p class="muted">Click a gradient to copy its CSS.</p>
    </Fragment>
    <div class="gradients">
      {
        gradients.map((g) => {
          const css = gradientCss(g);
          return (
            <button
              type="button"
              class="gradient"
              style={`background: ${css}`}
              data-copy={`background: ${css};`}
              data-copy-message={`Copied ${colors[g.from].name} → ${colors[g.to].name} gradient`}
              aria-label={`Copy ${colors[g.from].name} to ${colors[g.to].name} gradient CSS`}
            >
              <span style={`color: ${ink(g.from)}`}>{colors[g.from].name}</span>
              <span style={`color: ${ink(g.to)}`}>{colors[g.to].name}</span>
            </button>
          );
        })
      }
    </div>
  </Sub>

  <Sub id="themes" title="Themes" number="3.9">
    <Fragment slot="text">
      <p>Each theme pairs one background with one foreground across three tonal steps. Contrast ratios are calculated with WCAG 2.2.</p>
    </Fragment>
    <div class="themes">
      {
        themes.map((theme) => (
          <section class="theme-group" aria-label={`${theme.name} themes`}>
            <p>
              {theme.name} <span class="muted">— {theme.intro}</span>
            </p>
            <div class="theme-row" style={`--theme-count: ${theme.steps.length}`}>
              {theme.steps.map((step) => {
                const bg = colors[step.bg];
                const fg = colors[step.fg];
                const ratio = contrast(bg.hex, fg.hex);
                return (
                  <figure class="theme">
                    <div class="theme-card" style={`background: ${bg.hex}; color: ${fg.hex}`}>
                      <span class="theme-aa">Aa</span>
                    </div>
                    <figcaption>
                      <span class="theme-meta">
                        <span>{step.label}</span>
                        <span class="muted">
                          {ratio.toFixed(1)}:1 {wcag(ratio)}
                        </span>
                      </span>
                      <span class="theme-tokens">
                        <button type="button" class="value" data-copy={fg.hex}>
                          <span class="dot" style={`background: ${fg.hex}`} /> {fg.token}
                        </button>
                        <button type="button" class="value" data-copy={bg.hex}>
                          <span class="dot" style={`background: ${bg.hex}`} /> {bg.token}
                        </button>
                      </span>
                    </figcaption>
                  </figure>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </Sub>
  <Sub id="pantone" title="PANTONE & CMYK" number="3.10">
    <Fragment slot="text">
      <p>Choose the finish that matches your paper. Coated (C) and uncoated (U) references cover the full palette. Uncoated references use the same PANTONE numbers; their appearance changes with the stock. Proof both spot inks and process colors before production.</p>
      <p class="muted">CMYK values are C / M / Y / K percentages, converted from the digital palette using relative colorimetric rendering with black-point compensation. They simulate the screen colors in process ink; they are not PANTONE ink recipes.</p>
      <dl class="rules">
        {printStocks.map(stock => <div>
          <dt>{printProfiles[stock].stock} · {printProfiles[stock].condition}</dt>
          <dd><a href={printProfiles[stock].url} target="_blank" rel="noopener noreferrer">{printProfiles[stock].name} ↗</a></dd>
        </div>)}
      </dl>
      <p class="muted">Paper stock supplies Cream, Paper and White in spot-color work. Their CMYK values apply when simulating the color on the profile’s reference white; do not add that tint to an already matching stock. Use 0 / 0 / 0 / 100 for small black text and fine rules; the converted Black below is for larger color areas.</p>
      <div class="btn-row">
        <a class="btn" href={printReference.url} target="_blank" rel="noopener noreferrer">PANTONE Color Finder ↗</a>
        <a class="btn" href={withBase('/assets/brand/print-colors.json')} download="atomsai-print-colors.json">Download print values</a>
      </div>
    </Fragment>
    <div class="print-table-wrap" role="region" aria-label="Print color references" tabindex="0">
      <table class="print-table">
        <caption class="visually-hidden">PANTONE references and profile-based CMYK percentages for all 26 colors. Physical proof required.</caption>
        <thead><tr><th scope="col">Color / HEX</th>{printStocks.map(stock => <th scope="col">{printProfiles[stock].stock}<span class="muted print-detail">CMYK · {printProfiles[stock].condition}</span></th>)}</tr></thead>
        <tbody>{allColors.map(c => <tr>
          <th scope="row"><button class="print-sample" type="button" style={`background: ${c.hex}`} data-copy={c.hex} aria-label={`Copy ${c.name} HEX ${c.hex}`} /><span>{c.name}</span><span class="muted print-detail">{c.hex}</span></th>
          {printStocks.map(stock => {
            const match = printMatch(c, stock);
            return <td>
              <button class="value" type="button" title={match.note || match.status} data-copy={`${match.label} — ${printProfiles[stock].stock}; ${match.status}`} data-copy-message={`${c.name} ${printProfiles[stock].stock.toLowerCase()} reference copied`} aria-label={`Copy ${c.name} ${printProfiles[stock].stock.toLowerCase()} ${match.label}`}>{match.label}</button>
              <span class="print-detail"><button class="value muted" type="button" data-copy={cmykCopy(c, stock)} data-copy-message={`${c.name} CMYK ${printProfiles[stock].condition} copied`} aria-label={`Copy ${c.name} CMYK ${printProfiles[stock].condition}`}>{cmykFor(c, stock).join(' / ')}</button></span>
            </td>;
          })}
        </tr>)}</tbody>
      </table>
    </div>
  </Sub>
</Guide>

<style>
  .print-table-wrap { overflow-x: auto; }
  .print-table { width: 100%; border-collapse: collapse; font-size: var(--size-annotation); text-align: left; }
  .print-table th, .print-table td { padding: 1rem 0; border-bottom: 1px solid var(--rule); vertical-align: middle; }
  .print-table th { font-weight: 500; }
  .print-table th + th, .print-table td { padding-left: 1.5rem; }
  .print-sample { display: block; width: 6rem; height: 4rem; border: 0; padding: 0; margin-bottom: 0.625rem; box-shadow: inset 0 0 0 1px var(--rule); cursor: copy; }
  .print-detail { display: block; margin-top: 0.5rem; font-weight: 400; }
  .print-table td { white-space: nowrap; }

  .accent-stacking { padding: clamp(1rem, 4vw, 3rem); background: var(--black); }
  .accent-stacking-art { position: relative; aspect-ratio: 2.3; }
  .accent-stacking-art span { position: absolute; display: block; }
  .stack-iris-dark { left: 0; top: 0; width: 31.5%; height: 100%; background: var(--iris-dark); }
  .stack-iris { left: 18%; bottom: 0; width: 25%; height: 77.5%; background: var(--iris); }
  .stack-iris-light { left: 29%; bottom: 0; width: 19.5%; height: 57.5%; background: var(--iris-light); }
  .stack-crimson { left: 53%; bottom: 0; width: 32%; height: 73.75%; background: var(--crimson); }
  .stack-orange { left: 64%; top: 15%; width: 25.5%; height: 58.75%; background: var(--orange); }
  .stack-apricot { right: 0; top: 0; width: 18%; height: 41.25%; background: var(--apricot); }


  .mosaic {
    display: grid;
    grid-template-columns: 1.42fr 1.85fr 1.42fr 1fr;
    height: clamp(26rem, 60vh, 36rem);
  }

  .mosaic-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .mosaic-col :global(.swatch) {
    min-height: 3rem;
  }

  .roles {
    display: grid;
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    gap: 1.25rem;
  }

  .role :global(.role-chip) {
    width: 100%;
    height: clamp(11rem, 22vw, 17rem);
  }

  /* The values below each swatch, a step smaller than annotations, ruled between rows. */
  .specs {
    margin-top: 0.25rem;
    font-size: var(--size-annotation-small);
  }

  .specs > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 0.625rem;
  }

  .specs > div + div {
    border-top: 1px solid var(--rule);
  }

  .value {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
    text-align: left;
    cursor: copy;
  }

  .value:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .ramp {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .ramp :global(.swatch) {
    aspect-ratio: 2 / 5;
    min-height: 12rem;
  }

  .combos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .gradients {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .gradient {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 2 / 3;
    padding: 0.75rem;
    border: 0;
    font-size: var(--size-annotation);
    text-align: left;
    cursor: copy;
  }

  .themes {
    display: grid;
    gap: 2.5rem;
  }

  .theme-group {
    display: grid;
    gap: 1rem;
  }

  .theme-row {
    display: grid;
    grid-template-columns: repeat(var(--theme-count, 3), minmax(0, 1fr));
    gap: 1.25rem;
  }

  .theme-card {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .theme-aa {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5.5rem);
    letter-spacing: -0.015em;
    line-height: 1;
  }

  .theme figcaption {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .theme-meta,
  .theme-tokens {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--deep-green) 20%, transparent);
  }

  @media (max-width: 760px) {
    .print-table { table-layout: fixed; font-size: var(--size-annotation-small); }
    .print-table th:first-child { width: 27%; }
    .print-table th + th, .print-table td { padding-left: 0.75rem; white-space: normal; }
    .print-sample { width: min(5rem, 100%); }

    .mosaic {
      grid-template-columns: 1fr 1fr;
      height: auto;
    }

    .mosaic-col {
      min-height: 14rem;
    }

    .mosaic-col :global(.swatch) {
      min-height: 4.25rem;
    }

    .roles,
    .combos,
    .theme-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .ramp {
      grid-template-columns: minmax(0, 1fr);
    }

    .ramp :global(.swatch) {
      aspect-ratio: auto;
      min-height: 3.5rem;
    }

    .gradients {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
