---
import Guide from '../../layouts/Guide.astro';
import GlassDownloads from '../../components/GlassDownloads.astro';
import Sub from '../../components/Sub.astro';
import DownloadGroup from '../../components/DownloadGroup.astro';
import FontGrid from '../../components/FontGrid.astro';
import LogoDownloads from '../../components/LogoDownloads.astro';
import PhotographyDownloads from '../../components/PhotographyDownloads.astro';
import PrintPatternDownloads from '../../components/PrintPatternDownloads.astro';
import { downloadCategories } from '../../data/downloads';
import { logoVariants } from '../../data/logoExports';
import { withBase } from '../../data/base';
import logoManifest from '../../../public/logos/manifest.json';

const googleFonts = [['Chivo', 'Headlines'], ['Inter', 'Body text']].map(([name, role]) => ({
  name, family: name, weight: 400, detail: role, href: `https://fonts.google.com/specimen/${name}`,
}));

const logoBytes = logoManifest.files.reduce((total, file) => total + file.bytes, 0);
---

<Guide slug="assets" description="AtomsAI brand assets to download, one by one or a whole category at once.">
  <Sub id="logos" title="Logos" number="10.1">
    <div class="logo-library">
      <div class="package-bar">
        <p class="muted">{logoManifest.files.length} files · {(logoBytes / 1024 / 1024).toFixed(1)} MB</p>
        <a class="btn" href={withBase('/assets/logos.zip')} download="atomsai-logos.zip">Download all logos ↓</a>
      </div>
      {logoVariants.map((variant) => <LogoDownloads variant={variant} />)}
    </div>
  </Sub>
  {
    downloadCategories.map((c, i) => (
      <Sub id={c.id} title={c.title} number={`10.${i + 2}`}>
        <DownloadGroup category={c} />
      </Sub>
    ))
  }
  <Sub id="google-fonts" title="Google Fonts" number="10.3">
    <FontGrid cards={googleFonts} />
  </Sub>
  <Sub id="patterns" title="Patterns">
    <Fragment slot="text">
      <p>56 print sets across Drift, Offset, Single band and Concentric, in Forest, Sage, Graphite and Iris. Each set includes an editable Illustrator master, a CMYK print PDF and an RGB PNG preview.</p>
      <p>300 × 300 mm trim with 3 mm bleed. Prepared for Coated FOGRA39, an assumed coated-offset condition; confirm it with your printer before production. See the <a href={withBase('/patterns/')}>pattern guidelines</a> for usage.</p>
    </Fragment>
    <PrintPatternDownloads />
  </Sub>
  <Sub id="ai-identity" title="AI identity">
    <Fragment slot="text"><p>AtomsAI Signal: idle, listening, thinking and speaking. 32 static and animated SVGs in four inks, plus a working HTML reference, state data and usage guide.</p></Fragment>
    <div class="btn-row"><a class="btn" href={withBase('/assets/ai-identity.zip')} download="atomsai-ai-identity.zip">Download Signal kit ↓</a><a class="btn" href={withBase('/ai-identity/')}>Explore AI identity →</a></div>
  </Sub>
  <Sub id="photography" title="Photography" number="10.4">
    <Fragment slot="text"><p>Read the <a href={withBase('/photography/')}>photography guidelines</a> for people, art direction and image usage.</p></Fragment>
    <PhotographyDownloads />
  </Sub>
  <Sub id="glass" title="Glass styling"><GlassDownloads /></Sub>
</Guide>

<style>
  .logo-library { display: grid; gap: 3rem; }
  .package-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
</style>
