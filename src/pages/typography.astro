---
import '../styles/workspace-fonts.css';
import Guide from '../layouts/Guide.astro';
import Sub from '../components/Sub.astro';
import chivoLicense from '../assets/workspace-fonts/chivo-OFL.txt?url';
import interLicense from '../assets/workspace-fonts/inter-OFL.txt?url';

const faces = [
  { name: 'Founders Grotesk Regular', role: 'Primary — Display', family: 'var(--font-display)', weight: 400 },
  { name: 'Founders Grotesk Medium', role: 'Primary — Emphasis', family: 'var(--font-display)', weight: 500 },
  { name: 'PP Neue Montreal Regular', role: 'Body', family: 'var(--font-text)', weight: 400 },
];

const comparisons = [
  {
    role: 'Headline · Regular', leading: 43.2, copy: 'The future isn’t imagined. It’s built.',
    fonts: [
      { name: 'Founders Grotesk', weight: 400, styleName: 'Regular', size: '48pt', tracking: '−1.5%', spacing: '-0.015em' },
      { name: 'Chivo', weight: 400, styleName: 'Regular', size: '41pt', tracking: '−4%', spacing: '-0.04em' },
    ],
  },
  {
    role: 'Headline · Medium', leading: 43.2, copy: 'Your competitors are automating.',
    fonts: [
      { name: 'Founders Grotesk', weight: 500, styleName: 'Medium', size: '48pt', tracking: '−1.5%', spacing: '-0.015em' },
      { name: 'Chivo', weight: 600, styleName: 'Semibold', size: '41.5pt', tracking: '−2.5%', spacing: '-0.025em' },
    ],
  },
  {
    role: 'Body · Regular', leading: 16.8,
    copy: 'Our engineers embed with your team and ship AI agents into the workflows you already run.',
    fonts: [
      { name: 'PP Neue Montreal', weight: 400, styleName: 'Regular', size: '12pt', tracking: 'Normal', spacing: 'normal' },
      { name: 'Inter', weight: 400, styleName: 'Regular', size: '11.25pt', tracking: '−2%', spacing: '-0.02em' },
    ],
  },
];

const charset = [
  ['Uppercase', 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'],
  ['Lowercase', 'abcdefghijklmnopqrstuvwxyz'],
  ['Numbers', '1234567890'],
  ['Accented', 'Áá Çç Ëë Îî Ňň Öö Řř Şş Ţţ Ůů Ŵŵ Ŷŷ Żż'],
  ['Ligatures', 'fi fl fb fh fk ffb ffh'],
  ['Punctuation', '(,.:;?!)[&@#] {-–—}/“”‘’'],
  ['Symbols', '€$£¥¢%+−×÷=≈<>'],
  ['Misc.', '©®™*'],
];
---

<Guide slug="typography" description="Founders Grotesk and PP Neue Montreal: typefaces, scale and headline rules.">
  <Sub id="typefaces" title="Typefaces" number="5.2">
    <Fragment slot="text">
      <p>
        Our type system pairs two typefaces to keep layouts simple and considered. Founders Grotesk is our primary
        typeface. Sharp, confident and compact, it sets headlines and display type in Regular and Medium.
      </p>
      <p>PP Neue Montreal is our body typeface, used for running text, captions and interface copy where clarity matters most.</p>
      <p class="muted">Every specimen on this page is editable. Click one to try your own copy.</p>
    </Fragment>
    <p class="hero balance" contenteditable="plaintext-only" spellcheck="false">AtomsAI<br />Built to ship.</p>
    <div class="faces">
      {
        faces.map((f) => (
          <article class="face" style={`--family: ${f.family}; --weight: ${f.weight}`}>
            <header>
              <p>{f.name}</p>
              <p class="muted">{f.role}</p>
            </header>
            <p class="face-alphabet" contenteditable="plaintext-only" spellcheck="false">
              ABCDEFGHIJKLMN OPQRSTUVWXYZ abcdefghijklmn opqrstuvwxyz 1234567890,.?!*
            </p>
            <p class="face-headline balance" contenteditable="plaintext-only" spellcheck="false">
              The future isn’t imagined. It’s built.
            </p>
            <p class="face-lead balance" contenteditable="plaintext-only" spellcheck="false">
              Turn operational friction into operating leverage.
            </p>
          </article>
        ))
      }
    </div>
  </Sub>

  <Sub id="character-set" title="Character set" number="5.3">
    <Fragment slot="text">
      <p>
        An overview of the main character sets in Founders Grotesk, shown here in Regular. The typeface also includes
        tabular and lining figures, fractions and ordinals.
      </p>
      <p>Use the default forms shown here in our communication, and switch to tabular figures for tables and data.</p>
    </Fragment>
    <dl class="charset">
      {
        charset.map(([label, glyphs]) => (
          <div class="charset-row">
            <dt class="muted">{label}</dt>
            <dd contenteditable="plaintext-only" spellcheck="false">{glyphs}</dd>
          </div>
        ))
      }
    </dl>
  </Sub>

  <Sub id="scale" title="Scale & line-height" number="5.4">
    <Fragment slot="text">
      <p>
        Line-height is the space between baselines. It sets the rhythm and readability of our type, and the strength of
        its voice.
      </p>
      <p>
        As type gets larger, tighten the line-height. As it gets smaller, open it up so the eye has room to rest.
        Use 90–100% leading for headlines. The specimens below use 90% for display, 120% for the lead and 140% for body text.
      </p>
    </Fragment>
    <div class="scale">
      <figure>
        <p class="scale-display balance" contenteditable="plaintext-only" spellcheck="false">The future isn’t imagined. It’s built.</p>
        <figcaption class="muted">Display — Founders Grotesk Regular — 80 px — 90%</figcaption>
      </figure>
      <figure>
        <p class="scale-lead balance" contenteditable="plaintext-only" spellcheck="false">
          AtomsAI turns operational friction into operating leverage. Our engineers embed with your team and ship AI
          agents into the workflows you already run.
        </p>
        <figcaption class="muted">Display — Founders Grotesk Regular — 32 px — 120%</figcaption>
      </figure>
      <figure>
        <p class="scale-body" contenteditable="plaintext-only" spellcheck="false">
          We don’t sell AI. We ship your workflow. Our engineers embed with your team, map the work as it really runs
          and build agents inside your own systems, under your credentials. Accuracy, cost and latency are measured
          from a baseline, and the code, prompts and evals are yours from week one.
        </p>
        <figcaption class="muted">Body — PP Neue Montreal Regular — 16 px — 140%</figcaption>
      </figure>
    </div>
  </Sub>

  <Sub id="headlines" title="Headlines" number="5.5">
    <Fragment slot="text">
      <p>When setting headlines in Founders Grotesk, keep leading and tracking consistent across all applications and sizes.</p>
      <dl class="rules">
        <div>
          <dt>Leading</dt>
          <dd class="muted">Between 90% and 100% of the type size, depending on headline size.</dd>
        </div>
        <div>
          <dt>Tracking</dt>
          <dd class="muted">−15 (−1.5%) for all headlines.</dd>
        </div>
        <div>
          <dt>Case</dt>
          <dd class="muted">Headlines are always set in sentence case, with punctuation.</dd>
        </div>
      </dl>
    </Fragment>
    <div class="compare">
      <figure>
        <div class="leading" style="--lh: 1.176">
          <p class="headline default balance" contenteditable="plaintext-only" spellcheck="false">Your competitors are automating.</p>
          <span class="leading-measure" aria-hidden="true"><span>118%</span></span>
        </div>
        <figcaption class="muted">Default — leading auto (118%) — tracking 0</figcaption>
      </figure>
      <figure>
        <div class="leading" style="--lh: 0.9">
          <p class="headline applied balance" contenteditable="plaintext-only" spellcheck="false">Your competitors are automating.</p>
          <span class="leading-measure" aria-hidden="true"><span>90%</span></span>
        </div>
        <figcaption class="muted">Applied — leading 90% — tracking −15</figcaption>
      </figure>
    </div>
    <figure class="applied-large">
      <p class="headline applied big balance" contenteditable="plaintext-only" spellcheck="false">The future isn’t imagined. It’s built.</p>
      <figcaption class="muted">Founders Grotesk Regular — leading 90% — tracking −15 — sentence case</figcaption>
    </figure>
  </Sub>
  <Sub id="google-workspace" title="Google Workspace alternatives" number="5.6">
    <Fragment slot="text">
      <p>Use Chivo for headlines and Inter for body text in shared slides and documents.</p>
    </Fragment>
    <div class="scale workspace-comparisons">
      <p class="muted" id="font-comparison">Edit either sample to compare.</p>
      {comparisons.map(({ role, leading, copy, fonts }) => (
        <div class:list={['font-pair', { 'body-pair': role === 'Body · Regular' }]} data-font-pair>
          <h3>{role}</h3>
          {fonts.map(({ name, weight, styleName, size, tracking, spacing }) => (
            <figure>
              <p contenteditable="plaintext-only" spellcheck="false" aria-label={`${name} ${role} sample`}
                style={{ fontFamily: `'${name}', sans-serif`, fontSize: size, fontWeight: weight,
                  letterSpacing: spacing, lineHeight: `${leading}pt` }}>
                {copy}
              </p>
              <figcaption class="muted">{name} {styleName} — {size.replace('pt', ' pt')} type · {leading} pt leading · {tracking} tracking</figcaption>
            </figure>
          ))}
        </div>
      ))}
      <p><a href="https://fonts.google.com/specimen/Chivo">Get Chivo</a> · <a href={chivoLicense}>Chivo license</a><br />
        <a href="https://fonts.google.com/specimen/Inter">Get Inter</a> · <a href={interLicense}>Inter license</a></p>
    </div>
  </Sub>
</Guide>

<script>
  for (const pair of document.querySelectorAll('[data-font-pair]')) {
    const samples = pair.querySelectorAll<HTMLElement>('[contenteditable]');
    for (const sample of samples) {
      sample.addEventListener('input', () => {
        for (const peer of samples) {
          if (peer !== sample) peer.innerText = sample.innerText;
        }
      });
    }
  }
</script>

<style>
  .scale.workspace-comparisons {
    gap: clamp(3rem, 5vw, 5rem);
  }

  .font-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.25rem, 4vw, 4rem) 1.5rem;
    border-top: 1px solid var(--rule);
    padding-top: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  .body-pair { grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .font-pair h3 { grid-column: 1 / -1; }
  .font-pair figure { align-content: start; }
  .font-pair p { padding-bottom: 0.22em; overflow-wrap: anywhere; }

  [contenteditable] {
    outline: none;
    border-radius: 2px;
  }

  [contenteditable]:focus-visible {
    box-shadow: 0 0 0 1px var(--rule);
  }

  .hero {
    margin-bottom: 3rem;
    padding-bottom: 0.22em;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.015em;
  }

  .faces {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* Specimens size to their own column (cqi), so line breaks hold at any layout width. */
  .face {
    container-type: inline-size;
    display: grid;
    align-content: start;
    gap: 1.75rem;
    padding-left: 1rem;
    border-left: 1px solid var(--fg);
    font-family: var(--family);
    font-weight: var(--weight);
  }

  .face header {
    display: grid;
    gap: 0.625rem;
    font-family: var(--font-text);
    font-weight: 400;
  }

  .face header p:first-child {
    font-family: var(--family);
    font-weight: var(--weight);
    font-size: 1.375rem;
  }

  .face-alphabet {
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .face-headline {
    font-size: clamp(1.75rem, 15cqi, 3.25rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .face-lead {
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .charset {
    container-type: inline-size;
    display: grid;
  }

  .charset-row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }

  /* Room for descenders below the trimmed baseline. */
  .charset-row dd {
    padding-bottom: 0.2em;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.8cqi, 3.75rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .scale {
    display: grid;
    gap: 3rem;
  }

  .scale figure,
  .compare figure,
  .applied-large {
    display: grid;
    gap: 0.75rem;
  }

  /* Text is trimmed at the baseline, so large specimens keep room for their descenders. */
  .scale-display,
  .scale-lead,
  .headline {
    padding-bottom: 0.22em;
  }

  .scale-display {
    max-width: 10em;
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.015em;
  }

  .scale-lead {
    max-width: 24em;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .scale-body {
    max-width: 36em;
    font-size: 1rem;
    line-height: 1.4;
  }

  .compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .compare figure {
    container-type: inline-size;
    padding: 1.5rem;
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .headline {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 4rem);
  }

  .headline.default {
    line-height: normal;
    letter-spacing: 0;
  }

  .headline.applied {
    line-height: 0.9;
    letter-spacing: -0.015em;
  }

  .headline.big {
    max-width: 11em;
    font-size: clamp(3rem, 6vw, 5.5rem);
  }

  /* Leading made visible: a guide on every baseline and a bracket measuring one line of leading
     (baseline to baseline). Text is trimmed to cap height, so the first baseline sits 0.63em
     (Founders Grotesk's cap height) below the top; auto leading is its ascent plus descent, 117.6%. */
  .leading {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 9cqi, 4rem);
  }

  .leading .headline {
    padding-right: 3.5rem;
    font-size: inherit;
    line-height: var(--lh);
    background-image: linear-gradient(to top, color-mix(in srgb, var(--iris) 60%, transparent) 1px, transparent 1px);
    background-position: 0 calc(0.63em - var(--lh) * 1em);
    background-size: 100% calc(var(--lh) * 1em);
  }

  /* Guides fill the pixel above each baseline, so the bracket starts 1px higher to sit on them. */
  .leading-measure {
    position: absolute;
    top: calc(0.63em - 1px);
    right: 0;
    width: 0.5rem;
    height: calc(var(--lh) * 1em + 1px);
    border: 1px solid var(--iris);
    border-left: 0;
  }

  .leading-measure span {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.5rem);
    translate: 0 -50%;
    color: var(--iris);
    font-family: var(--font-text);
    font-size: var(--size-annotation);
    line-height: 1;
  }

  @media (max-width: 1000px) {
    .faces,
    .compare {
      grid-template-columns: minmax(0, 1fr);
    }

    .charset-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>
