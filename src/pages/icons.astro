---
import Guide from '../layouts/Guide.astro';
import Sub from '../components/Sub.astro';
import Figure from '../components/Figure.astro';
import IconLibrary from '../components/IconLibrary.astro';
import IconGrid from '../components/IconGrid.astro';
import { icon } from '../data/icons';
import miter from '../assets/brand/diagrams/icon-miter-joins.svg?raw';
import butt from '../assets/brand/diagrams/icon-butt-caps.svg?raw';
import regular from '../assets/brand/diagrams/icon-weight-regular.svg?raw';
import medium from '../assets/brand/diagrams/icon-weight-medium.svg?raw';

const inline = (name: string) => icon(name).replace('<svg ', '<svg aria-hidden="true" class="btn-icon" ');
const buttons = [
  { label: 'Learn more', trailing: 'arrow-right' },
  { label: 'Search', leading: 'search' },
  { label: 'Filter', leading: 'filter' },
  { label: 'What’s this?', leading: 'info', badge: true },
  { label: 'Create New...', leading: 'plus' },
];
---

<Guide slug="icons" description="The AtomsAI stroke icon set: style, weight and a downloadable library.">
  <Sub id="style" title="Style" number="6.1">
    <Fragment slot="text">
      <p>Icons are drawn with one even stroke on a 24 px grid, the same line as our illustrations.</p>
      <p>
        Keep corners sharp with miter joins and end every open stroke with a butt cap, so lines stop exactly on the grid.
        Never round joins or caps.
      </p>
    </Fragment>
    <div class="pair">
      <Figure caption="Miter joins — corners stay sharp and land on the grid." tone="plain"><IconGrid svg={miter} /></Figure>
      <Figure caption="Butt caps — strokes stop flush at their end point." tone="plain"><IconGrid svg={butt} /></Figure>
    </div>
  </Sub>

  <Sub id="weight" title="Weight" number="6.2">
    <Fragment slot="text">
      <p>Icons use two stroke weights, matched to our type.</p>
      <dl class="rules">
        <div>
          <dt>Regular — 1.5 px</dt>
          <dd class="muted">Pairs with body copy and interface text. Default for most icons.</dd>
        </div>
        <div>
          <dt>Medium — 2 px</dt>
          <dd class="muted">Pairs with headlines and Medium labels. Use for emphasis and at small sizes.</dd>
        </div>
      </dl>
      <p>Weights are measured at 24 px. Scale the stroke with the icon, using the Scale tool (K) in Figma, so line weight stays in proportion.</p>
    </Fragment>
    <div class="pair">
      <Figure caption="Regular (400) — 1.5 px stroke" tone="plain"><IconGrid svg={regular} tone="light" /></Figure>
      <Figure caption="Medium (500) — 2 px stroke" tone="plain"><IconGrid svg={medium} tone="light" /></Figure>
    </div>
  </Sub>

  <Sub id="library" title="Library" number="6.3">
    <Fragment slot="text">
      <p>
        A starter set of icons in our stroke style. As you add new icons, draw them on the same 24 px grid with a
        Regular stroke, miter joins, butt caps and open gaps where strokes cross, so the set stays cohesive.
      </p>
      <p class="muted">Pick a color and weight, then copy or download any icon. SVGs keep the 24 px grid; PNGs export at 512 px.</p>
    </Fragment>
    <IconLibrary />
  </Sub>

  <Sub id="in-use" title="In use" number="6.4">
    <Fragment slot="text">
      <p>Icons sit inline with labels in buttons and links, in the same color as the text.</p>
      <p>
        Size the icon to the label and scale the stroke with it, so it always reads as Regular weight. Keep a fixed gap
        between icon and label.
      </p>
      <p>Lead with the icon to name an action. Trail with an arrow when the button takes you somewhere next.</p>
    </Fragment>
    <div class="in-use">
      {
        buttons.map((b) => (
          <span class="pill">
            {b.leading && <span class:list={['pill-icon', { badge: b.badge }]} set:html={inline(b.leading)} />}
            <span class="pill-label">{b.label}</span>
            {b.trailing && <span class="pill-icon" set:html={inline(b.trailing)} />}
          </span>
        ))
      }
    </div>
  </Sub>
</Guide>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .in-use {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: 1rem;
    min-height: 24rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--cream);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.3em 0.6em;
    border-radius: 999px;
    background: var(--deep-green);
    color: var(--cream);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .pill-label {
    text-box: trim-both cap alphabetic;
  }

  /* Icons draw within 16 of their 24 grid units, so a 1.5cap box makes the drawing exactly as
     tall as the capitals. The grid's 4-unit margin is pulled in at the pill edges. */
  .pill-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.5cap;
    height: 1.5cap;
  }

  .pill-icon:first-child {
    margin-left: -0.25cap;
  }

  .pill-icon:last-child {
    margin-right: -0.25cap;
  }

  .pill-icon :global(svg) {
    width: 100%;
    height: 100%;
    /* Regular weight at any size: 1.5 px at 24 px */
    stroke-width: 1.5;
  }

  /* The info badge: a circle just over cap height, with the same outer spacing as the line icons. */
  .pill-icon.badge {
    width: 1.1cap;
    height: 1.1cap;
    margin: 0 0.2cap;
    border-radius: 50%;
    background: var(--cream);
    color: var(--deep-green);
  }

  .pill-icon.badge:first-child {
    margin-left: 0;
  }

  @media (max-width: 900px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
