---
import Guide from '../layouts/Guide.astro';
import Sub from '../components/Sub.astro';
import Figure from '../components/Figure.astro';
import { withBase } from '../data/base';
import Illustration3D from '../components/Illustration3D.astro';
import { colors } from '../data/colors';
import { namespaceSvgIds } from '../scripts/svg';

const files = import.meta.glob<string>('../assets/brand/illustration/*.svg', { query: '?raw', import: 'default', eager: true });
let illustrationInstance = 0;
const svg = (name: string) => namespaceSvgIds(
  files[`../assets/brand/illustration/${name}.svg`].trim(), `illustration-${illustrationInstance++}`,
);

const concepts = [
  { slug: 'full-visibility', title: 'Full Visibility', caption: 'We map every workflow, system and handoff before we build.' },
  { slug: 'built-in-your-stack', title: 'Built In Your Stack', caption: 'Agents run inside your own systems, under your credentials and permissions.' },
  { slug: 'compounding-outcomes', title: 'Compounding Outcomes', caption: 'Each workflow we ship becomes leverage for the next one.' },
];

const objects = [
  { slug: 'stack', title: 'Stack', width: '202.236px' },
  { slug: 'input', title: 'Input', width: '201px' },
  { slug: 'orbit', title: 'Orbit', width: '240px' },
  { slug: 'stack-2', title: 'Stack 2', width: '181px' },
  { slug: 'focus', title: 'Focus' },
  { slug: 'modular', title: 'Modular' },
  { slug: 'always-on', title: 'Always on' },
  { slug: 'momentum', title: 'Momentum' },
  { slug: 'layers', title: 'Layers' },
  { slug: 'states', title: 'States' },
  { slug: 'unfolding', title: 'Unfolding' },
  { slug: 'nested', title: 'Nested' },
  { slug: 'filtering', title: 'Filtering' },
  { slug: 'precision', title: 'Precision' },
  { slug: 'versatility', title: 'Versatility' },
];

---

<Guide slug="illustration" description="AtomsAI illustration style and linework, ready to download.">
  <Sub id="style" title="Style" number="7.1">
    <Fragment slot="text">
      <p>
        Our illustrations express abstract ideas through simple geometry: outlined 2D and 3D forms drawn with a single
        line weight. One concept per drawing, minimal and precise.
      </p>
      <p>Fine monochrome outlines, translucent layers and a soft Iris fade. Keep the center clear and let the color build gently toward the edge.</p>
    </Fragment>
    <div class="grid three">
      {
        concepts.map((c) => (
          <div class="concept">
            <Illustration3D slug={c.slug} name={c.title} svg={svg(c.slug)} />
            <p class="muted">{c.caption}</p>
          </div>
        ))
      }
    </div>
  </Sub>

  <Sub id="linework" title="Linework" number="7.2">
    <Fragment slot="text">
      <p>
        Use thin, precise Paper outlines on Forest shade, or Forest shade outlines on Paper. Hidden linework stays at 35% opacity behind any number of surfaces. Visible and highlighted outlines stay at full opacity. Always on and Versatility use opaque surfaces: hidden edges, including highlighted edges, are omitted.
      </p>
      <p>Center each drawing with generous clear space. Use diamond fades on isometric rectangular surfaces, aligned to all four edges. Use radial fades on curved surfaces. Preserve the order and transparency of overlapping layers.</p>
    </Fragment>
    <div class="grid three">
      {
        objects.map((o) => (
          <Illustration3D slug={o.slug} name={o.title} svg={svg(o.slug)} artWidth={'width' in o ? o.width : '200px'} />
        ))
      }
    </div>
  </Sub>
  <Sub id="usage-limits" title="Usage limits" number="7.3">
    <Fragment slot="text">
      <p>Use one lead illustration per slide, hero or editorial layout. In a feature grid, use up to three illustrations, with one per card. On a long page, apply this limit to each section.</p>
      <p>Keep one idea and one illustration mode per group. Leave clear space of at least one eighth of the artwork width around each drawing. Place copy outside this space.</p>
    </Fragment>
    <div class="usage-pair">
      <Figure caption="Do — one centered object with space for its caption.">
        <div class="layout-example">
          <div class="example-art" set:html={svg('focus').replaceAll('SURFACE', colors.forestShade.hex)} />
          <p>Focus on the work that matters.</p>
        </div>
      </Figure>
      <Figure caption="Don’t — several unrelated objects competing inside one card.">
        <div class="layout-example crowded dont-example">
          <div class="example-art" set:html={svg('focus').replaceAll('SURFACE', colors.forestShade.hex)} />
          <div class="extra-art" set:html={svg('momentum').replaceAll('SURFACE', colors.forestShade.hex)} />
          <div class="extra-art second" set:html={svg('modular').replaceAll('SURFACE', colors.forestShade.hex)} />
          <p>Focus on the work that matters.</p>
        </div>
      </Figure>
    </div>
  </Sub>

  <Sub id="size-stroke" title="Size & stroke" number="7.4">
    <Fragment slot="text">
      <p>Measure the full artwork frame at its final display size. Simple isometric objects start at 200 px wide. Concept drawings and objects with dense internal detail start at 280 px. Below these sizes, use an <a href={withBase('/icons/')}>icon</a>.</p>
      <p>Scale artwork and strokes together. Use a 1 px outline at a 200 px artwork width. The samples below scale the Focus master and its linework together.</p>
      <p>Check at 100% on the target screen. Keep lines at least 1 px thick and the smallest visible gap at least 2 px. Increase the artwork size if its details merge. For print, proof at the final physical size.</p>
    </Fragment>
    <div class="size-specimens">
      {[200, 280, 420, 560].map((width) => (
        <Figure tone="plain" caption={`${width} px frame · ${(width / 200).toFixed(2)} px stroke`}>
          <div class="size-scroll">
            <div class="sized-art" style={`width: ${width}px`} set:html={svg('focus').replaceAll('SURFACE', colors.forestShade.hex)} />
          </div>
        </Figure>
      ))}
    </div>
    <p class="muted">Samples display at their labelled sizes. Scroll horizontally on smaller screens.</p>
  </Sub>

  <Sub id="readability" title="Readability" number="7.5">
    <div class="usage-pair">
      <Figure caption="Do — keep concept drawings at 280 px or larger.">
        <div class="detail-example">
          <div style="width: 280px" set:html={svg('full-visibility').replaceAll('SURFACE', colors.forestShade.hex)} />
        </div>
      </Figure>
      <Figure caption="Don’t — shrink a detailed drawing into an icon slot.">
        <div class="detail-example dont-example">
          <div style="width: 64px" set:html={svg('full-visibility').replaceAll('SURFACE', colors.forestShade.hex)} />
        </div>
      </Figure>
      <Figure caption="Do — preserve stroke proportions as the object scales.">
        <div class="detail-example">
          <div style="width: 200px" set:html={svg('focus').replaceAll('SURFACE', colors.forestShade.hex)} />
        </div>
      </Figure>
      <Figure caption="Don’t — thicken the stroke until interior gaps close.">
        <div class="detail-example dont-example">
          <div style="width: 200px" set:html={svg('focus').replaceAll('SURFACE', colors.forestShade.hex).replaceAll('stroke-width="1.4"', 'stroke-width="8"')} />
        </div>
      </Figure>
    </div>
  </Sub>
</Guide>

<style>
  .usage-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 1.25rem;
  }

  .layout-example {
    position: relative;
    display: grid;
    place-items: center;
    gap: 2rem;
    padding: 3rem 2rem;
    background: var(--forest-shade);
    color: var(--paper);
  }

  .example-art { width: 200px; max-width: 100%; }
  .extra-art { position: absolute; width: 160px; top: 1rem; left: 0.5rem; }
  .extra-art.second { top: 6rem; left: auto; right: 0.5rem; }
  .size-specimens { display: grid; gap: 3rem; margin-bottom: 2rem; }
  .size-specimens :global(.figure-body), .usage-pair :global(.figure-body) { min-width: 0; }
  .size-scroll { overflow-x: auto; background: var(--forest-shade); }
  .sized-art { flex-shrink: 0; color: var(--paper); }
  .detail-example {
    display: grid;
    place-items: center;
    min-height: 352px;
    padding: 2rem;
    overflow-x: auto;
    color: var(--paper);
    background: var(--forest-shade);
  }

  .dont-example { position: relative; }
  .dont-example::after {
    content: '';
    position: absolute;
    inset: 1.25rem;
    pointer-events: none;
    background:
      linear-gradient(to top right, transparent calc(50% - 1px), var(--iris-dark) calc(50% - 1px), var(--iris-dark) calc(50% + 1px), transparent calc(50% + 1px)),
      linear-gradient(to bottom right, transparent calc(50% - 1px), var(--iris-dark) calc(50% - 1px), var(--iris-dark) calc(50% + 1px), transparent calc(50% + 1px));
  }

  @media (max-width: 760px) {
    .usage-pair { grid-template-columns: minmax(0, 1fr); }
  }

  .grid {
    display: grid;
    gap: 2rem 1.25rem;
  }

  .three {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  .concept {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  @media (max-width: 1000px) {
    .three {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
