---
import Guide from '../layouts/Guide.astro';
import Sub from '../components/Sub.astro';
import AppIconGuides from '../components/AppIconGuides.astro';
import AssetCard from '../components/AssetCard.astro';
import ClearSpace from '../components/ClearSpace.astro';
import Figure from '../components/Figure.astro';
import LockupKerning from '../components/LockupKerning.astro';
import LockupRatios from '../components/LockupRatios.astro';
import MarkConstruction from '../components/MarkConstruction.astro';
import MinimumSize from '../components/MinimumSize.astro';
import Placement from '../components/Placement.astro';
import { appIconSvg, lockup, logotypeSvg, markSvg } from '../data/logos';

// The wordmark's cap height as a share of the mark, from the lockup geometry.
const capHeightRatio = Math.round(((lockup.baseline - lockup.capTop) / lockup.height) * 100);
---

<Guide slug="logo" description="The AtomsAI mark and logotype: rules and downloads in every color.">
  <Sub id="mark" title="Mark" number="2.1">
    <Fragment slot="text">
      <p>
        The mark is drawn from two mirrored sets of three circles. Vertical cuts slice them into arcs, and the shapes
        between the cuts form its blades, an echo of light passing through parallel slits.
      </p>
      <p>Always use the master artwork. Never redraw or adjust the mark.</p>
    </Fragment>
    <div class="stack">
      <AssetCard id="atomsai-mark" name="Mark" svg={markSvg} artWidth="clamp(5rem, 22%, 9rem)" previewHeight="clamp(18rem, 30vw, 26rem)" />
      <Figure caption="Mark construction" tone="plain">
        <MarkConstruction />
      </Figure>
    </div>
  </Sub>

  <Sub id="logotype" title="Logotype" number="2.4">
    <Fragment slot="text">
      <p>
        Our logotype pairs the mark with the AtomsAI wordmark. “Atoms” is set in a regular weight and “AI” in bold, so the
        name reads as one word with a clear emphasis.
      </p>
      <p>Use it in Cream on Deep green, or Deep green on Cream. Always use the master artwork. Never retype, redraw or recolor the logotype.</p>
      <p>The mark and wordmark are locked together in fixed proportions. Never rescale, respace or rearrange the two parts.</p>
      <dl class="rules">
        <div>
          <dt>Wordmark kerning</dt>
          <dd class="muted">The wordmark is custom-kerned, with spacing tightened between each pair of letters.</dd>
        </div>
        <div>
          <dt>Height ratio</dt>
          <dd class="muted">The wordmark’s cap height is {capHeightRatio}% of the mark’s height.</dd>
        </div>
        <div>
          <dt>Gap</dt>
          <dd class="muted">The gap between the mark and the wordmark is 0.3X, where X is the mark’s height. If the mark is 200 px tall, the gap is 60 px.</dd>
        </div>
      </dl>
    </Fragment>
    <div class="stack">
      <AssetCard id="atomsai-logotype" name="Logotype" svg={logotypeSvg} artWidth="clamp(12rem, 55%, 26rem)" previewHeight="clamp(18rem, 30vw, 26rem)" />
      <LockupKerning />
      <LockupRatios />
    </div>
  </Sub>

  <Sub id="clear-space" title="Clear space" number="2.2">
    <Fragment slot="text">
      <p>
        Give the mark room to breathe. Keep a clear zone of half its width (X/2) on either side and half its height (Y/2)
        above and below.
      </p>
      <p>
        Around the logotype, keep a clear zone equal to the width of the mark (X) on the left and right, and the height of
        the mark (Y) above and below.
      </p>
      <p>No type, imagery or other graphic elements should enter this space.</p>
    </Fragment>
    <div class="stack">
      <Figure caption="Mark — X/2 and Y/2" tone="plain"><ClearSpace variant="mark" /></Figure>
      <Figure caption="Logotype — X and Y" tone="plain"><ClearSpace variant="logotype" /></Figure>
    </div>
  </Sub>

  <Sub id="placement" title="Placement" number="2.3">
    <Fragment slot="text">
      <p>
        Place the mark at the top, middle or bottom of a layout, aligned to the left or right margin. Place the logotype at
        the top, middle or bottom, always aligned to the left margin.
      </p>
      <p>
        This applies to every format: portrait, landscape and square, in print and digital. Choose the position that
        creates natural hierarchy and asymmetrical negative space.
      </p>
    </Fragment>
    <div class="stack">
      <Figure caption="Mark — top, middle or bottom, left or right" tone="plain"><Placement variant="mark" /></Figure>
      <Figure caption="Logotype — top, middle or bottom, always left" tone="plain"><Placement variant="logotype" /></Figure>
    </div>
  </Sub>

  <Sub id="minimum-size" title="Minimum size" number="2.8">
    <Fragment slot="text">
      <p>
        A minimum size keeps the logotype legible and recognizable wherever it appears. Print can reproduce finer detail
        than a screen, so the print minimum is smaller in proportion.
      </p>
      <dl class="rules">
        <div>
          <dt>Digital</dt>
          <dd class="muted">Never reproduce the logotype narrower than 100 px.</dd>
        </div>
        <div>
          <dt>Print</dt>
          <dd class="muted">Never reproduce the logotype narrower than 25 mm (1 in).</dd>
        </div>
      </dl>
      <p>Below these sizes, use the mark on its own.</p>
    </Fragment>
    <MinimumSize />
  </Sub>

  <Sub id="app-icon" title="App icon" number="2.11">
    <Fragment slot="text">
      <p>
        Where an app icon, favicon or social avatar is needed, the logo is reduced to the mark, set in Cream on Deep
        green. The mark spans 60% of the container width, centered, leaving an equal margin (X) on each side.
      </p>
      <p>
        Use the icon only where the full logotype cannot fit. It never replaces the logotype in layouts, and it is never
        used as a sign-off.
      </p>
    </Fragment>
    <div class="pair">
      <AssetCard id="atomsai-icon-rounded" name="Rounded square" svg={appIconSvg('square')} options={null} artWidth="9rem" previewHeight="20rem" pngSize={1024} />
      <AssetCard id="atomsai-icon-circle" name="Circle" svg={appIconSvg('circle')} options={null} artWidth="9rem" previewHeight="20rem" pngSize={1024} />
      <Figure tone="plain"><AppIconGuides shape="square" /></Figure>
      <Figure tone="plain"><AppIconGuides shape="circle" /></Figure>
    </div>
  </Sub>

  <Sub id="name-in-copy" title="Name in copy" number="2.10">
    <Fragment slot="text">
      <p>
        When the name appears in text, always write it as one word: AtomsAI. Capital A, capital AI, no space, set in the
        same weight as the surrounding copy.
      </p>
      <p>Lowercase atomsai is reserved for the web address and social handles.</p>
    </Fragment>
    <div class="copy-examples">
      <figure>
        <p class="example-headline balance">AtomsAI ships AI that works. In production.</p>
        <figcaption class="muted">1 — AtomsAI in headlines</figcaption>
      </figure>
      <figure>
        <p class="example-body">
          Most AI projects stall between the pilot and the real workflow. AtomsAI embeds engineers with your team to map
          the work as it actually runs, build agents inside your own systems and measure every result against a
          baseline. The code, prompts and evals are yours from week one.
        </p>
        <figcaption class="muted">2 — AtomsAI in body copy</figcaption>
      </figure>
      <div class="dont">
        <p class="muted">Never write</p>
        <ul>
          <li><s>Atoms AI</s></li>
          <li><s>AtomsAi</s></li>
          <li><s>Atoms.ai</s></li>
          <li><s>ATOMSAI</s></li>
        </ul>
      </div>
    </div>
  </Sub>
</Guide>

<style>
  .stack {
    display: grid;
    gap: 2rem;
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.25rem;
  }


  .copy-examples {
    display: grid;
    gap: 2rem;
  }

  .copy-examples figure {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .example-headline {
    max-width: 14em;
    padding-bottom: 0.22em;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .example-body {
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .dont ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
