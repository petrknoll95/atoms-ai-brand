---
// Mark reveal: the animated mark from the atoms-ai-slit-logo sketch. Six slits each clip a
// circle; on a 4 s loop the circles retreat outward until they clear their slits, then return,
// outer pair first. Native SVG animation (SMIL), identical to the sketch's animated export.
// With controls (Tools page) it becomes a tool like the pattern generator: a 4:3 stage with the
// colorways top left and the export frame dashed in the middle, and a Tweakpane panel on the right.
import { colors } from '../data/colors';
import { keyTimesOf, markBounds, slitBlades, slitClip, slitMotion } from '../data/slitLogo';

interface Props {
  uid: string;
  controls?: boolean;
  class?: string;
}

const { uid, controls = false, class: className } = Astro.props;

const round = (v: number) => +v.toFixed(4);
const bounds = markBounds();
const viewBox = [bounds.x, bounds.y, bounds.width, bounds.height].map(round).join(' ');
const blades = slitBlades().map((b) => {
  const hidden = b.cx - b.direction * b.distance;
  return {
    ...b,
    id: `${uid}-slit-${b.n}-${b.direction}`,
    values: [b.cx, b.cx, hidden, hidden, b.cx, b.cx].map(round).join(';'),
    keyTimes: keyTimesOf(b.n),
  };
});

const colorways = [
  { key: 'deep-green-white', label: 'Deep green on White', fg: colors.deepGreen.hex, bg: colors.white.hex, tone: 'light' },
  { key: 'cream-deep-green', label: 'Cream on Deep green', fg: colors.cream.hex, bg: colors.deepGreen.hex, tone: 'dark' },
  { key: 'black-white', label: 'Black on White', fg: colors.black.hex, bg: colors.white.hex, tone: 'light' },
  { key: 'white-black', label: 'White on Black', fg: colors.white.hex, bg: colors.black.hex, tone: 'dark' },
];
const initial = colorways[0];
---

<div
  class:list={['reveal', { tool: controls }, className]}
  data-reveal
  data-tone={initial.tone}
  style={controls ? `--reveal-fg: ${initial.fg}; --reveal-bg: ${initial.bg}; --ratio: 1; --logo: 40` : undefined}
>
  <div class="stage">
    {
      controls && (
        <fieldset class="options">
          <legend class="visually-hidden">Mark colors</legend>
          {colorways.map((c, i) => (
            <label class="color-option" title={c.label}>
              <input type="radio" name={`${uid}-colors`} checked={i === 0} data-reveal-color data-fg={c.fg} data-bg={c.bg} data-tone={c.tone} />
              <span class="dot" style={`--ink: ${c.fg}; --surface: ${c.bg}`} />
              <span class="visually-hidden">{c.label}</span>
            </label>
          ))}
        </fieldset>
      )
    }
    <div class="area">
      <div class="frame">
        <svg class="reveal-svg" viewBox={viewBox} role="img" aria-label="The AtomsAI mark hiding and revealing itself">
          <defs>
            {
              blades.map((b) => (
                <clipPath id={b.id} clipPathUnits="userSpaceOnUse">
                  <rect x={round(b.x)} y={slitClip.y} width={round(b.w)} height={slitClip.height} />
                </clipPath>
              ))
            }
          </defs>
          {
            blades.map((b) => (
              <g clip-path={`url(#${b.id})`}>
                <circle cx={round(b.cx)} cy="50" r={round(b.r)}>
                  <animate
                    attributeName="cx"
                    values={b.values}
                    dur={`${slitMotion.seconds}s`}
                    repeatCount="indefinite"
                    calcMode="spline"
                    keyTimes={b.keyTimes}
                    keySplines={slitMotion.keySplines}
                  />
                </circle>
              </g>
            ))
          }
        </svg>
      </div>
    </div>
  </div>
  {controls && <div class="pane tp-theme" data-reveal-pane />}
</div>

<script>
  import { exportMarkVideo } from '../scripts/slit-logo';
  import { downloadBlob } from '../scripts/svg';
  import { notify } from '../scripts/actions';

  // Reduced motion shows the full mark, paused. Otherwise it loops.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Video formats; the resolution is the shorter side.
  const formats: Record<string, { label: string; ratio: number }> = {
    square: { label: 'Square 1:1', ratio: 1 },
    landscape: { label: 'Landscape 16:9', ratio: 16 / 9 },
    story: { label: 'Story 9:16', ratio: 9 / 16 },
    portrait: { label: 'Portrait 4:5', ratio: 4 / 5 },
  };

  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>('.reveal-svg')!;
    if (reduced) {
      svg.setCurrentTime(0);
      svg.pauseAnimations();
    }

    const host = root.querySelector<HTMLElement>('[data-reveal-pane]');
    if (!host) return;

    // The colorway swatches on the stage.
    root.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement;
      if (!input.matches('[data-reveal-color]')) return;
      root.style.setProperty('--reveal-fg', input.dataset.fg!);
      root.style.setProperty('--reveal-bg', input.dataset.bg!);
      root.dataset.tone = input.dataset.tone;
    });

    void buildPane(root, svg, host);
  });

  // Tweakpane loads only where there is a panel (Tools), never for the plain mark on the cover.
  async function buildPane(root: HTMLElement, svg: SVGSVGElement, host: HTMLElement) {
    const [{ Pane }, { addSteppers }] = await Promise.all([import('tweakpane'), import('../scripts/tweakpane')]);
    const state = { format: 'square', resolution: 1080, logo: 40 };
    const pane = new Pane({ container: host });

    const format = pane
      .addBinding(state, 'format', { label: 'Format', options: Object.fromEntries(Object.entries(formats).map(([key, f]) => [f.label, key])) })
      .on('change', () => root.style.setProperty('--ratio', String(formats[state.format].ratio)));
    addSteppers(format, 'format');
    addSteppers(pane.addBinding(state, 'resolution', { label: 'Resolution', options: { '720p': 720, '1080p': 1080, '4K': 2160 } }), 'resolution');
    pane
      .addBinding(state, 'logo', { label: 'Logo size', min: 10, max: 90, step: 1, format: (v) => `${v}%` })
      .on('change', () => root.style.setProperty('--logo', String(state.logo)));

    const play = pane.addButton({ title: svg.animationsPaused() ? 'Play' : 'Pause' });
    play.on('click', () => {
      if (svg.animationsPaused()) svg.unpauseAnimations();
      else svg.pauseAnimations();
      play.title = svg.animationsPaused() ? 'Play' : 'Pause';
    });

    // The video at the chosen format and resolution, in the current colors, with the mark at the
    // chosen share of the width.
    const download = pane.addButton({ title: 'Download video' });
    download.on('click', async () => {
      const ratio = formats[state.format].ratio;
      const even = (v: number) => Math.round(v / 2) * 2;
      const width = ratio >= 1 ? even(state.resolution * ratio) : state.resolution;
      const height = ratio >= 1 ? state.resolution : even(state.resolution / ratio);
      const { fg, bg } = root.querySelector<HTMLInputElement>('[data-reveal-color]:checked')!.dataset;

      download.disabled = true;
      let shown = -1;
      try {
        const { blob, extension } = await exportMarkVideo({
          width,
          height,
          fg: fg!,
          bg: bg!,
          logo: state.logo / 100,
          onProgress: (done) => {
            const step = Math.floor(done * 10);
            if (step !== shown) {
              shown = step;
              notify(`Rendering video… ${step * 10}%`);
            }
          },
        });
        downloadBlob(blob, `atomsai-mark-reveal-${state.format}-${width}x${height}.${extension}`);
        notify('Video downloaded');
      } catch (error) {
        notify(error instanceof Error ? error.message : 'Video export failed');
      } finally {
        download.disabled = false;
      }
    });
  }
</script>

<style>
  .reveal {
    position: relative;
    color: var(--reveal-fg, var(--fg));
  }

  .reveal-svg {
    display: block;
    width: 100%;
    height: auto;
    fill: currentColor;
  }

  /* The tool on the Tools page: the stage on the left, the panel on the right. */
  .tool {
    --stage-ring: var(--fg);
    --dot-edge: color-mix(in srgb, var(--deep-green) 25%, transparent);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
    gap: var(--gutter);
    align-items: start;
  }

  .tool[data-tone='dark'] {
    --stage-ring: var(--white);
    --dot-edge: color-mix(in srgb, var(--white) 45%, transparent);
  }

  /* 4:3 stage: the colorways, then the export frame in the space left. */
  .tool .stage {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 1rem;
    min-width: 0;
    aspect-ratio: 4 / 3;
    padding: 1rem;
    background: var(--reveal-bg);
    box-shadow: inset 0 0 0 1px var(--rule);
    transition: background-color 160ms ease;
  }

  .tool[data-tone='dark'] .stage {
    box-shadow: none;
  }

  /* The export frame, fitted to the stage at the chosen aspect ratio. */
  .tool .area {
    container-type: size;
    display: grid;
    place-items: center;
    min-height: 0;
  }

  .tool .frame {
    display: grid;
    place-items: center;
    width: min(100cqw, 100cqh * var(--ratio));
    aspect-ratio: var(--ratio);
    outline: 1px dashed color-mix(in srgb, var(--reveal-fg) 45%, transparent);
    transition: width 200ms ease;
  }

  .tool .reveal-svg {
    width: calc(var(--logo) * 1%);
  }

  /* Tweakpane sets its own colors; keep the stage's mark color out of it. */
  .pane {
    color: var(--fg);
  }

  .options {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .color-option {
    position: relative;
    cursor: pointer;
  }

  .color-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* Split dots: the mark color over the background, like the asset canvases. */
  .dot {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--ink) 50%, var(--surface) 50%);
    box-shadow:
      inset 0 0 0 1px var(--dot-edge),
      0 0 0 2px var(--reveal-bg),
      0 0 0 3px transparent;
  }

  input:checked + .dot {
    box-shadow:
      inset 0 0 0 1px var(--dot-edge),
      0 0 0 2px var(--reveal-bg),
      0 0 0 3px var(--stage-ring);
  }

  input:focus-visible + .dot {
    outline: 1.5px solid var(--stage-ring);
    outline-offset: 4px;
  }

  @media (max-width: 1100px) {
    .tool {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Narrow screens: a fixed-height preview instead of the 4:3 stage. */
  @media (max-width: 760px) {
    .tool .stage {
      aspect-ratio: auto;
    }

    .tool .area {
      height: 18rem;
    }
  }
</style>
