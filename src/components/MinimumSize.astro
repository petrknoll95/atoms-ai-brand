---
// 2.8 Minimum size, drawn in HTML from the Figma slide. Each logotype is rendered at its real
// minimum width: 100 CSS px on screen, 25 mm in print units.
import { logotypeSvg } from '../data/logos';

const sizes = [
  { medium: 'Digital', width: '100px', label: '100 px' },
  { medium: 'Print', width: '25mm', label: '25 mm / 1 in' },
];
---

<div class="minimum">
  {
    sizes.map((s) => (
      <div class="frame">
        <p>{s.medium}</p>
        <div class="specimen" style={`--min-w: ${s.width}`}>
          <span class="art" role="img" aria-label={`Logotype at ${s.label}`} set:html={logotypeSvg} />
          <span class="measure">{s.label}</span>
        </div>
      </div>
    ))
  }
</div>

<style>
  .minimum {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .frame {
    display: grid;
    grid-template-rows: auto 1fr;
    aspect-ratio: 1;
    padding: 1.25rem;
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .specimen {
    display: grid;
    place-self: center;
    gap: 0.875rem;
    width: var(--min-w);
    /* Keep the specimen optically centered: offset the label row above it. */
    margin-top: calc(-1 * var(--size-annotation));
  }

  .art {
    color: var(--forest-shade);
    line-height: 0;
  }

  .art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .measure {
    display: grid;
    place-items: center;
    height: 1.625rem;
    border-inline: 1px solid var(--deep-green);
    font-size: var(--size-annotation);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .minimum {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
