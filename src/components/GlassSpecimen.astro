---
import { markSvg } from '../data/logos';
import { icon } from '../data/icons';
interface Props { variant: 'banner' | 'post'; theme?: 'light' | 'dark'; }
const { variant, theme = 'light' } = Astro.props;
---
<div class:list={['glass-scene', variant, theme]}>
  {variant === 'post' && <canvas data-glass-pattern data-density="0" aria-hidden="true"></canvas>}
  <div class:list={['atoms-glass-wrap', 'prompt', {
    'atoms-glass--pill': variant === 'banner',
    'atoms-glass--light': theme === 'light' && variant === 'banner',
    'atoms-glass--dark': theme === 'dark',
  }]}>
    <span class="atoms-glass__shadow" aria-hidden="true"></span>
    <div class="atoms-glass">
      <div class="atoms-glass__content">
        {variant === 'banner' && <>
          <span class="prompt-mark" aria-hidden="true"><slot name="mark"><Fragment set:html={markSvg} /></slot></span>
          <p>Can an AI agent clear our claims backlog?</p>
          <span class="prompt-send" aria-hidden="true" set:html={icon('arrow-up')} />
        </>}
      </div>
    </div>
  </div>
  <slot name="overlay" />
</div>

<script>
  import { composePattern, colorwayFor } from '../scripts/pattern-renderer';
  // The panel uses the brand renderer; the enlarged pill sits on a flat fill.
  const observer = new ResizeObserver(entries => {
    for (const entry of entries) {
      const canvas = entry.target as HTMLCanvasElement;
      const { width, height } = entry.contentRect;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      if (width < 1 || height < 1) continue;
      void composePattern(canvas, {
        structure: 'drift', density: Number(canvas.dataset.density),
        colors: colorwayFor('drift', 'Forest'),
        width: Math.round(width * dpr), height: Math.round(height * dpr), rotation: 90,
      });
    }
  });
  document.querySelectorAll<HTMLCanvasElement>('[data-glass-pattern]').forEach(canvas => observer.observe(canvas));
</script>

<style>
  .glass-scene { position: relative; overflow: hidden; display: grid; place-items: center; background: var(--forest-shade); container-type: inline-size; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .banner { aspect-ratio: 4 / 3; display: flex; background: var(--mist); }
  .banner.dark { background: var(--forest-green); }
  .post { aspect-ratio: 1; padding: 1.75rem; }
  .prompt { width: 100%; font-family: var(--font-display); font-size: 20px; line-height: 1; }
  .banner .prompt { flex: 0 0 auto; width: max-content; margin-left: 18%; font-size: 9cqw; }
  .post .prompt { --glass-radius: 1.5em; }
  .prompt :global(.atoms-glass__content) { display: flex; align-items: center; gap: .625em; padding: .65em .8em; }
  .post .prompt :global(.atoms-glass__content) { aspect-ratio: 4 / 3; padding: 0; }
  .prompt p { flex: 1; text-wrap: pretty; }
  .banner .prompt p { white-space: nowrap; }
  .prompt-mark { width: 1.6em; flex: 0 0 1.6em; }
  .prompt-send { display: grid; place-items: center; width: 1.6em; height: 1.6em; flex: 0 0 1.6em; border-radius: 50%; background: var(--cream); color: var(--deep-green); }
  .prompt-mark :global(svg) { width: 100%; height: auto; fill: currentColor; }
  .prompt-send :global(svg) { width: 60%; height: 60%; }
  @container (max-width: 350px) {
    .post .prompt { font-size: 18px; }
  }
</style>
