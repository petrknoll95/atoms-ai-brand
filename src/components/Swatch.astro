---
// A color chip: its name bottom left, and a small menu top right that copies the color as HEX,
// RGB, CMYK (where defined) or its CSS variable. The menu is a popover anchored to its button.
import { bare, colors, contrast, rgb, type ColorKey } from '../data/colors';

interface Props {
  color: ColorKey;
  class?: string;
  style?: string;
}

const { color, class: className, style } = Astro.props;
const c = colors[color];
// Pick whichever brand ink reads best on this color.
const ink = contrast(c.hex, colors.deepGreen.hex) >= contrast(c.hex, colors.cream.hex) ? colors.deepGreen.hex : colors.cream.hex;

const [r, g, b] = rgb(c.hex);
const values = [
  { label: 'HEX', shown: bare(c.hex), copy: c.hex },
  { label: 'RGB', shown: `${r} ${g} ${b}`, copy: `rgb(${r}, ${g}, ${b})` },
  ...(c.cmyk ? [{ label: 'CMYK', shown: c.cmyk.join(' '), copy: `C${c.cmyk[0]} M${c.cmyk[1]} Y${c.cmyk[2]} K${c.cmyk[3]}` }] : []),
  { label: 'CSS', shown: `--${c.token}`, copy: `var(--${c.token})` },
];

// The same color can appear several times on a page, so each menu needs its own id and anchor.
const id = `swatch-${c.token}-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['swatch', className]} style={`--swatch: ${c.hex}; --ink: ${ink}; --anchor: --${id};${style ?? ''}`}>
  <span class="name">{c.name}</span>
  <button type="button" class="menu-button" popovertarget={id} aria-label={`Copy ${c.name} values`} title="Copy values">
    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="3" cy="8" r="1.25" /><circle cx="8" cy="8" r="1.25" /><circle cx="13" cy="8" r="1.25" /></svg>
  </button>
  <div class="menu" id={id} popover data-swatch-menu>
    <p class="menu-title muted">Copy {c.name}</p>
    {
      values.map((v) => (
        <button type="button" class="menu-item" data-copy={v.copy} data-copy-message={`Copied ${c.name} ${v.copy}`}>
          <span class="muted">{v.label}</span>
          <span>{v.shown}</span>
        </button>
      ))
    }
  </div>
</div>

<script>
  // Close a menu once a value is copied (the shared handler in actions.ts does the copying).
  document.addEventListener('click', (event) => {
    const item = (event.target as Element).closest('[data-swatch-menu] [data-copy]');
    item?.closest<HTMLElement>('[data-swatch-menu]')?.hidePopover();
  });
</script>

<style>
  .swatch {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 3.5rem;
    padding: 0.75rem;
    background: var(--swatch);
    color: var(--ink);
    font-size: var(--size-annotation);
  }

  /* A small dots button in the top right corner. */
  .menu-button {
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    opacity: 0.6;
    cursor: pointer;
    anchor-name: var(--anchor);
    transition:
      opacity 120ms ease,
      background-color 120ms ease;
  }

  .menu-button svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .menu-button:hover,
  .menu-button:focus-visible,
  .swatch:has(.menu:popover-open) .menu-button {
    opacity: 1;
    background: color-mix(in srgb, var(--ink) 14%, transparent);
  }

  .menu-button:focus-visible {
    outline: 1.5px solid var(--ink);
    outline-offset: 1px;
  }

  /* The menu, below the button and aligned to its right edge; it flips up near the bottom. */
  .menu {
    position-anchor: var(--anchor);
    position-area: bottom span-left;
    position-try-fallbacks: flip-block;
    min-width: 11rem;
    margin: 0.25rem 0;
    padding: 0.375rem;
    border: 0;
    background: var(--white);
    color: var(--fg);
    font-size: var(--size-annotation);
    box-shadow:
      0 0 0 1px var(--rule),
      0 0.5rem 1.5rem color-mix(in srgb, var(--forest-shade) 12%, transparent);
  }

  .menu-title {
    padding: 0.5rem 0.5rem 0.625rem;
  }

  .menu-item {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    padding: 0.5rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: copy;
  }

  .menu-item:hover,
  .menu-item:focus-visible {
    background: color-mix(in srgb, var(--deep-green) 7%, transparent);
    outline: none;
  }
</style>
