---
// 2.5 Lockup proportions, drawn in HTML around the master logotype, after the Figma slide:
// the wordmark's cap height is 80% of the mark's height, and the gap is 0.3X.
// Each panel is a 550 × 373 frame that crops the logotype; everything is placed in those units,
// so the panels scale with their width. Only the logotype itself is SVG.
import Figure from './Figure.astro';
import { lockup, logotypeSvg } from '../data/logos';

const W = 550;
const H = 373;
const s = 160 / lockup.height; // mark drawn 160 units tall
const lx = 90;
const ly = (H - lockup.height * s) / 2;
const markRight = lx + lockup.markWidth * s;
const markBottom = ly + lockup.height * s;
const wordLeft = lx + lockup.wordX * s;
const capTop = ly + lockup.capTop * s;
const baseline = ly + lockup.baseline * s;
const capHeight = Math.round(((lockup.baseline - lockup.capTop) / lockup.height) * 100);

// Panel units → percentages of the frame.
const pct = (v: number) => `${+(v * 100).toFixed(4)}%`;
const x = (v: number) => pct(v / W);
const y = (v: number) => pct(v / H);
const fromRight = (v: number) => pct((W - v) / W);

// Labels are 14 units: annotation size at 550 px, shrinking with the panel to an 11px floor.
const frame = `aspect-ratio: ${W} / ${H}; --label: ${+((14 / W) * 100).toFixed(4)}cqi`;
const art = `left: ${x(lx)}; top: ${y(ly)}; width: ${x(lockup.width * s)}`;
// Bracket beside the mark, from its top to its bottom.
const markBracket = `left: ${x(58)}; top: ${y(ly)}; width: ${x(8)}; height: ${y(markBottom - ly)}`;
---

<div class="ratios">
  <div class="pair">
    <Figure caption="Symbol / wordmark height ratio" tone="framed">
      <div class="panel" style={frame} role="img" aria-label={`The wordmark cap height is ${capHeight}% of the mark height`}>
        <div class="guide" style={`top: ${y(ly)}`}></div>
        <div class="guide" style={`top: ${y(markBottom)}`}></div>
        <div class="guide" style={`top: ${y(capTop)}`}></div>
        <div class="guide" style={`top: ${y(baseline)}`}></div>
        <div class="art" style={art} set:html={logotypeSvg} />
        <div class="bracket" style={markBracket}></div>
        <div class="bracket" style={`left: ${x(wordLeft - 9)}; top: ${y(capTop)}; width: ${x(8)}; height: ${y(baseline - capTop)}`}></div>
        <span class="label end" style={`right: ${fromRight(50)}; top: ${y((ly + markBottom) / 2)}`}>100%</span>
        <span class="label end" style={`right: ${fromRight(wordLeft - 15)}; top: ${y((capTop + baseline) / 2)}`}>{capHeight}%</span>
      </div>
    </Figure>

    <Figure caption="Symbol / wordmark gap" tone="framed">
      <div class="panel" style={frame} role="img" aria-label="The gap between mark and wordmark is 0.3 times the mark height">
        <div class="guide" style={`top: ${y(ly)}`}></div>
        <div class="guide" style={`top: ${y(markBottom)}`}></div>
        <div class="band" style={`left: ${x(markRight)}; width: ${x(wordLeft - markRight)}`}></div>
        <div class="art" style={art} set:html={logotypeSvg} />
        <div class="bracket" style={markBracket}></div>
        <div class="rule" style={`left: ${x(markRight)}; top: ${y(H / 2)}; width: ${x(wordLeft - markRight)}`}></div>
        <span class="label end" style={`right: ${fromRight(50)}; top: ${y((ly + markBottom) / 2)}`}>1X</span>
        <span class="label" style={`left: ${x((markRight + wordLeft) / 2)}; top: ${y(H / 2 - 14)}`}>0.3X</span>
      </div>
    </Figure>
  </div>
</div>

<style>
  /* Side by side while each panel is at least ~360px wide, so the labels keep their room. */
  .ratios {
    container-type: inline-size;
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .panel {
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    color: var(--iris);
  }

  .panel > * {
    position: absolute;
  }

  /* Dotted Iris guides at the mark's top and bottom, and the wordmark's cap top and baseline. */
  .guide {
    left: 0;
    right: 0;
    border-top: 1px dotted;
  }

  /* The 0.3X gap between mark and wordmark, outlined full height. */
  .band {
    top: 0;
    bottom: 0;
    border-inline: 1px solid;
  }

  .art {
    color: var(--forest-shade);
    line-height: 0;
  }

  .art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* [ — open to the right. */
  .bracket {
    border: 1px solid;
    border-right: 0;
  }

  .rule {
    border-top: 1px solid;
  }

  .label {
    translate: -50% -50%;
    font-family: var(--font-text);
    font-size: clamp(0.6875rem, var(--label), var(--size-annotation));
    line-height: 1;
    white-space: nowrap;
  }

  .label.end {
    translate: 0 -50%;
  }

  @container (max-width: 46rem) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
