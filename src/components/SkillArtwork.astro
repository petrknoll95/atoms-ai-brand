---
import { logotypeSvg } from '../data/logos';
import { icon } from '../data/icons';

interface Props { slug: string }
const isBrand = Astro.props.slug === 'atomsai-brand';
const samples = ['arrow-northeast', 'plus', 'search', 'filter', 'close', 'chevron-right'];
---

<div class:list={['art', { 'art-brand': isBrand, 'art-icons': !isBrand }]} aria-hidden="true">
  {isBrand ? (
    <>
      <span class="brand-art" set:html={logotypeSvg} />
      <span class="palette"><i /><i /><i /><i /></span>
    </>
  ) : samples.map((name) => <span class="icon-art" set:html={icon(name)} />)}
</div>

<style>
  .art { min-height: 10rem; padding: 2rem; background: var(--cream); color: var(--deep-green); }
  .art-brand { display: flex; justify-content: space-between; align-items: center; gap: 2rem; }
  .brand-art { width: min(62%, 20rem); }
  .brand-art :global(svg) { width: 100%; height: auto; }
  .palette { display: flex; align-self: stretch; width: 5rem; }
  .palette i { flex: 1; background: var(--deep-green); }
  .palette i:nth-child(2) { background: var(--forest-green); }
  .palette i:nth-child(3) { background: var(--sage-tint); }
  .palette i:nth-child(4) { background: var(--iris); }
  .art-icons { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); align-items: center; gap: 1rem; }
  .icon-art { display: grid; place-items: center; }
  .icon-art :global(svg) { width: 2rem; height: 2rem; }
  @media (max-width: 600px) {
    .art { padding: 1.5rem; min-height: 8rem; }
    .art-icons { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.25rem; }
  }
</style>
