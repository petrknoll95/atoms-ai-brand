---
// A framed diagram or image with an annotation-size caption.
interface Props {
  caption?: string;
  tone?: 'plain' | 'framed';
  class?: string;
}
const { caption, tone = 'framed', class: className } = Astro.props;
---

<figure class:list={['figure', tone, className]}>
  <div class="figure-body"><slot /></div>
  {caption && <figcaption class="muted">{caption}</figcaption>}
</figure>

<style>
  .figure {
    display: grid;
    gap: 0.625rem;
    align-content: start;
    min-width: 0;
  }

  .framed .figure-body {
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .figure-body :global(svg),
  .figure-body :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
