---
// The stroke icon set with shared color and weight controls. Each tile copies or downloads its icon.
import { defaultColorOptions } from '../data/assets';
import { iconWeights, icons } from '../data/icons';
import { colorize } from '../scripts/svg';

const selected = defaultColorOptions.find((o) => o.key === 'deep-green')!;
---

<div class="library" data-asset-group>
  <div class="toolbar">
    <fieldset class="options">
      <legend class="muted">Color</legend>
      {
        defaultColorOptions.map((o) => (
          <label class="color-option" title={o.label}>
            <input
              type="radio"
              name="icon-color"
              value={o.ink}
              checked={o === selected}
              data-asset-color={o.key}
              data-tone={o.tone}
              data-label={o.label}
            />
            <span class="dot" style={`--ink: ${o.ink}`} />
            <span class="visually-hidden">{o.label}</span>
          </label>
        ))
      }
      <span class="muted" data-asset-color-label>{selected.label}</span>
    </fieldset>
    <fieldset class="options">
      <legend class="muted">Weight</legend>
      {
        iconWeights.map((w, i) => (
          <label class="weight-option">
            <input type="radio" name="icon-weight" value={w.value} checked={i === 0} data-asset-weight={w.key} />
            <span>{w.label}</span>
          </label>
        ))
      }
    </fieldset>
  </div>

  <ul class="grid">
    {
      icons.map((i) => (
        <li class="tile" data-asset={`atomsai-icon-${i.name}`} data-png-size="512">
          <template data-asset-svg set:html={i.svg} />
          <div class="tile-art" data-asset-preview data-tone={selected.tone} set:html={colorize(i.svg, selected.ink)} />
          <p class="tile-name muted">{i.name}</p>
          <div class="tile-actions">
            <button class="btn" type="button" data-asset-action="copy-svg" aria-label={`Copy ${i.name} SVG`}>
              Copy
            </button>
            <button class="btn" type="button" data-asset-action="download-svg" aria-label={`Download ${i.name} SVG`}>
              SVG
            </button>
            <button class="btn" type="button" data-asset-action="download-png" aria-label={`Download ${i.name} PNG`}>
              PNG
            </button>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .library {
    display: grid;
    gap: 1.25rem;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .options legend {
    float: left;
    margin-right: 0.5rem;
  }

  .color-option,
  .weight-option {
    position: relative;
    cursor: pointer;
  }

  .color-option input,
  .weight-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .dot {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--ink);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--deep-green) 25%, transparent),
      0 0 0 2px var(--bg),
      0 0 0 3px transparent;
  }

  input:checked + .dot {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--deep-green) 25%, transparent),
      0 0 0 2px var(--bg),
      0 0 0 3px var(--fg);
  }

  input:focus-visible + .dot,
  input:focus-visible + span {
    outline: 1.5px solid var(--fg);
    outline-offset: 4px;
  }

  .weight-option span {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0 0.625rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
  }

  .weight-option input:checked + span {
    border-color: var(--fg);
    color: var(--fg);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 1.25rem;
  }

  .tile {
    position: relative;
    display: grid;
    gap: 0.5rem;
  }

  .tile-art {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--rule);
    transition: background-color 160ms ease;
  }

  .tile-art[data-tone='dark'] {
    background: var(--deep-green);
    box-shadow: none;
  }

  /* White icons always preview on Black. */
  .tile-art[data-tone='black'] {
    background: var(--black);
    box-shadow: none;
  }

  .tile-art :global(svg) {
    width: 34%;
    height: auto;
  }

  .tile-actions {
    position: absolute;
    inset: auto 0.5rem calc(1.4em + 1rem) 0.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .tile-actions .btn {
    min-height: 1.75rem;
    padding: 0 0.5rem;
  }

  .tile:hover .tile-actions,
  .tile:focus-within .tile-actions {
    opacity: 1;
  }

  @media (hover: none) {
    .tile-actions {
      position: static;
      opacity: 1;
      justify-content: start;
    }
  }
</style>
