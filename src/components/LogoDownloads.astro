---
import { withBase } from '../data/base';
import { logoColorways, type LogoVariant } from '../data/logoExports';
import manifest from '../../public/logos/manifest.json';
import LogoDownloadMenu from './LogoDownloadMenu.astro';

interface Props { variant: LogoVariant }
const { variant } = Astro.props;
const files = manifest.files.filter((file) => file.variant === variant.id);
---

<section class="logo-group" aria-labelledby={`${variant.id}-downloads-title`}>
  <div class="group-heading">
    <h3 class="display" id={`${variant.id}-downloads-title`}>{variant.name}</h3>
    <a class="btn" href={withBase(`/assets/logos/${variant.id}.zip`)} download={`atomsai-${variant.id}.zip`}>Download {variant.name.toLowerCase()} set ↓</a>
  </div>
  <ul class="logo-grid">
    {logoColorways.map(({ ink, background }) => {
      const colorFiles = files.filter((file) => file.inkToken === ink.token);
      const svg = colorFiles.find((file) => file.format === 'svg')!;
      return (
        <li class="logo-card">
          <div class="preview" data-ink={ink.token}>
            <img src={withBase(`/logos/${svg.path}`)} alt={`${variant.name}, ${ink.name}`} width={variant.id === 'logotype' ? 1132 : 440} height={variant.id === 'logotype' ? 200 : 400} loading="lazy" />
          </div>
          <div class="card-meta">
            <p>{ink.name}</p>
            <LogoDownloadMenu files={colorFiles} backgroundName={background.name} />
          </div>
        </li>
      );
    })}
  </ul>
  <p class="muted note">Transparent artwork. Add the required clear space in your layout.</p>
</section>

<style>
  .logo-group { container-type: inline-size; display: grid; gap: 1.5rem; }
  .group-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
  .logo-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem 1.25rem; }
  @container (min-width: 28rem) { .logo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .logo-card { min-width: 0; display: grid; gap: 1rem; align-content: start; }
  .preview { --check-base: #f7f7f7; --check: #ededed; display: grid; place-items: center; height: 12rem; padding: 2rem; background-color: var(--check-base); background-image: conic-gradient(var(--check) 25%, transparent 0 50%, var(--check) 0 75%, transparent 0); background-size: 16px 16px; box-shadow: inset 0 0 0 1px var(--rule); }
  .preview[data-ink='white'], .preview[data-ink='cream'] { --check-base: #303c37; --check: #3b4742; }
  .preview img { display: block; width: 100%; height: 100%; max-height: 8rem; object-fit: contain; }
  .card-meta { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; }
  .note { line-height: 1.4; }
</style>
