---
// 2.5 Wordmark kerning, drawn in HTML around the master logotype, after the Figma lockup slide:
// dotted guides at the mark's top and bottom and the x-height, solid guides at cap top and
// baseline, a dashed midline, the 0.3X gap outlined, and Iris bars bounding each kerned span.
// Values are in thousandths of an em. Everything is placed in lockup units (see `lockup`) inside a
// frame with the same aspect ratio, so the diagram scales with its width; only the logotype is SVG.
import Figure from './Figure.astro';
import { lockup, logotypeSvg } from '../data/logos';

const pad = 80;
const top = 70;
const W = lockup.width + pad * 2;
const H = lockup.height + top + 50;
const mid = lockup.height / 2;

// Lockup units → percentages of the frame.
const pct = (v: number) => `${+(v * 100).toFixed(4)}%`;
const x = (v: number) => pct((v + pad) / W);
const y = (v: number) => pct((v + top) / H);
const w = (v: number) => pct(v / W);
const h = (v: number) => pct(v / H);

const pairs = lockup.kerning.map((k) => ({ ...k, center: (k.bars[0] + k.bars[k.bars.length - 1] + k.bar) / 2 }));

// Labels stay at annotation size until the closest pair would touch (about 2.2em apart), then
// shrink with the frame down to an 11px floor.
const closest = Math.min(...pairs.slice(1).map((k, i) => k.center - pairs[i].center));
const labelSize = `${+((closest / 2.2 / W) * 100).toFixed(4)}cqi`;

const minus = (n: number) => String(n).replace('-', '−');
const label = `Custom kerning between each pair of letters in the wordmark, in thousandths of an em: ${pairs
  .map((k) => `${k.pair} ${minus(k.value)}`)
  .join(', ')}`;
---

<Figure caption="Wordmark kerning" tone="framed">
  <div class="diagram" style={`aspect-ratio: ${W} / ${H}; --label: ${labelSize}; --dash: ${w(6)}`} role="img" aria-label={label}>
    {pairs.map((k) => k.bars.map((b) => <div class="bar" style={`left: ${x(b)}; top: ${y(0)}; width: ${w(k.bar)}; height: ${h(lockup.height)}`} />))}
    <div class="guide dotted" style={`top: ${y(0)}`}></div>
    <div class="guide dotted" style={`top: ${y(lockup.height)}`}></div>
    <div class="guide" style={`top: ${y(lockup.capTop)}`}></div>
    <div class="guide dotted" style={`top: ${y(lockup.xTop)}`}></div>
    <div class="guide" style={`top: ${y(lockup.baseline)}`}></div>
    <div class="guide dashed" style={`top: ${y(mid)}`}></div>
    <div class="box" style={`left: ${x(lockup.markWidth)}; top: ${y(0)}; width: ${w(lockup.wordX - lockup.markWidth)}; height: ${h(lockup.height)}`}></div>
    <div class="art" style={`left: ${x(0)}; top: ${y(0)}; width: ${w(lockup.width)}`} set:html={logotypeSvg} />
    {
      pairs.map((k) => (
        <span class="value" style={`left: ${x(k.center)}; top: ${y(-22)}`}>
          {minus(k.value)}
        </span>
      ))
    }
  </div>
</Figure>

<style>
  .diagram {
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    color: var(--iris);
  }

  .diagram > * {
    position: absolute;
  }

  /* 1px Iris guides across the full width. */
  .guide {
    left: 0;
    right: 0;
    border-top: 1px solid;
  }

  .dotted {
    border-top-style: dotted;
  }

  /* 6-unit dashes, like the Figma midline (a dashed border would draw 3px dashes at any size). */
  .dashed {
    height: 1px;
    border: 0;
    background: repeating-linear-gradient(to right, currentColor 0 var(--dash), transparent 0 calc(var(--dash) * 2));
  }

  .box {
    border: 1px solid;
  }

  .bar {
    background: currentColor;
  }

  .art {
    color: var(--forest-shade);
    line-height: 0;
  }

  .art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .value {
    translate: -50% -50%;
    font-family: var(--font-text);
    font-size: clamp(0.6875rem, var(--label), var(--size-annotation));
    line-height: 1;
    white-space: nowrap;
  }
</style>
