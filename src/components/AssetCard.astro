---
// Downloadable artwork: live preview, color/weight options, Copy SVG, SVG and PNG download.
// The master SVG uses `currentColor` (and `SURFACE` for opaque fills); actions.ts applies
// the chosen option before copying or exporting.
import { defaultColorOptions, type ColorOption, type WeightOption } from '../data/assets';
import { colorize, withStrokeWidth } from '../scripts/svg';

interface Props {
  /** File name base, e.g. `atomsai-mark`. */
  id: string;
  name: string;
  svg: string;
  options?: ColorOption[] | null;
  defaultOption?: string;
  weights?: WeightOption[];
  /** Width of the artwork inside the preview. */
  artWidth?: string;
  previewHeight?: string;
  pngSize?: number;
  pickerStyle?: 'swatches' | 'labels' | 'themes';
}

const {
  id,
  name,
  svg,
  options = defaultColorOptions,
  defaultOption = 'deep-green',
  weights,
  artWidth = '50%',
  previewHeight = '14rem',
  pngSize = 2400,
  pickerStyle = 'swatches',
} = Astro.props;

const selected = options?.find((o) => o.key === defaultOption) ?? options?.[0];
let initial = selected ? colorize(svg, selected.ink, selected.surface) : svg;
if (weights?.length) initial = withStrokeWidth(initial, weights[0].value);
---

<article class="asset" data-asset={id} data-png-size={pngSize}>
  <template data-asset-svg set:html={svg} />
  <div
    class="stage"
    data-asset-tone
    data-tone={selected?.tone ?? 'light'}
    style={`--art-w: ${artWidth}; --preview-h: ${previewHeight}${selected?.surface ? `; --surface: ${selected.surface}` : ''}`}
  >
    <div class="preview" data-asset-preview role="img" aria-label={`${name} preview`} set:html={initial} />
    {
      ((options && options.length > 1) || (weights && weights.length > 1)) && (
        <div class="pickers">
          {options && options.length > 1 && (
            <fieldset class="options">
              <legend class="visually-hidden">{name} color</legend>
              {options.map((o) => (
                <label class:list={['color-option', { 'label-option': pickerStyle !== 'swatches' }]} title={pickerStyle === 'swatches' ? o.label : undefined}>
                  <input
                    type="radio"
                    name={`${id}-color`}
                    value={o.ink}
                    checked={o === selected}
                    data-asset-color={o.key}
                    data-surface={o.surface}
                    data-tone={o.tone}
                    data-label={o.label}
                  />
                  {pickerStyle === 'themes' ? <><span class="picker-label theme-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      {o.tone === 'light' ? <><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></> : <path d="M20.9 13.3A9 9 0 0 1 10.7 3.1 9 9 0 1 0 20.9 13.3Z" />}
                    </svg>
                  </span><span class="visually-hidden">{o.label}</span></> : pickerStyle === 'labels' ? <span class="picker-label">{o.label}</span> : <><span class="dot" style={`--ink: ${o.ink}; --surface: ${o.surface ?? o.ink}`} /><span class="visually-hidden">{o.label}</span></>}
                </label>
              ))}
            </fieldset>
          )}
          {weights && weights.length > 1 && (
            <fieldset class="options weights">
              <legend class="visually-hidden">{name} stroke weight</legend>
              {weights.map((w, i) => (
                <label class="weight-option">
                  <input type="radio" name={`${id}-weight`} value={w.value} checked={i === 0} data-asset-weight={w.key} />
                  <span>{w.label}</span>
                </label>
              ))}
            </fieldset>
          )}
        </div>
      )
    }
    <slot name="preview-controls" />
    <div class="btn-row">
      <button class="btn" type="button" data-asset-action="copy-svg">Copy SVG</button>
      <button class="btn" type="button" data-asset-action="download-svg">SVG ↓</button>
      <button class="btn" type="button" data-asset-action="download-png">PNG ↓</button>
    </div>
  </div>
  <div class="meta">
    <p>{name}</p>
    {selected && options && options.length > 1 && <p class="muted" data-asset-color-label>{selected.label}</p>}
  </div>
</article>

<style>
  .asset {
    display: grid;
    gap: 0.875rem;
    align-content: start;
  }

  /* The canvas: art centered, color picker top left, actions bottom right. Opaque artwork
     (linework) sets --surface, so the canvas always matches the fill. */
  .stage {
    --stage-bg: var(--surface, var(--white));
    --stage-ring: var(--fg);
    --dot-edge: color-mix(in srgb, var(--deep-green) 25%, transparent);
    display: grid;
    grid-template-areas: 'pickers' 'art' 'actions';
    grid-template-rows: minmax(2rem, auto) minmax(0, 1fr) minmax(2rem, auto);
    gap: 1.5rem;
    height: var(--preview-h);
    padding: 1rem;
    background: var(--stage-bg);
    box-shadow: inset 0 0 0 1px var(--rule);
    transition: background-color 160ms ease;
  }

  .stage[data-tone='dark'] {
    --stage-bg: var(--surface, var(--deep-green));
    --stage-ring: var(--cream);
    --dot-edge: color-mix(in srgb, var(--cream) 45%, transparent);
    box-shadow: none;
  }

  /* White artwork always previews on Black. */
  .stage[data-tone='black'] {
    --stage-bg: var(--surface, var(--black));
    --stage-ring: var(--white);
    --dot-edge: color-mix(in srgb, var(--white) 45%, transparent);
    box-shadow: none;
  }

  .preview {
    grid-area: art;
    display: grid;
    place-items: center;
    min-height: 0;
  }

  .preview :global(svg) {
    width: var(--art-w);
    height: auto;
    max-height: 100%;
  }

  .pickers {
    grid-area: pickers;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .btn-row {
    grid-area: actions;
    justify-content: flex-end;
    align-items: center;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .options {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .color-option,
  .weight-option {
    position: relative;
    cursor: pointer;
  }

  .color-option input,
  .weight-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .dot {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--ink) 50%, var(--surface) 50%);
    box-shadow:
      inset 0 0 0 1px var(--dot-edge),
      0 0 0 2px var(--stage-bg),
      0 0 0 3px transparent;
  }

  .picker-label { display: block; padding: 0.4rem 0.7rem; border: 1px solid transparent; border-radius: 999px; color: var(--stage-ring); font-size: var(--size-annotation); opacity: 0.6; }
  .theme-icon { width: 2rem; height: 2rem; padding: 0; display: grid; place-items: center; }
  input:checked + .picker-label { border-color: var(--stage-ring); opacity: 1; }

  input:checked + .dot {
    box-shadow:
      inset 0 0 0 1px var(--dot-edge),
      0 0 0 2px var(--stage-bg),
      0 0 0 3px var(--stage-ring);
  }

  input:focus-visible + .dot,
  input:focus-visible + span {
    outline: 1.5px solid var(--stage-ring);
    outline-offset: 4px;
  }

  .weight-option span {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0 0.625rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
  }

  .weight-option input:checked + span {
    border-color: var(--fg);
    color: var(--fg);
  }
</style>
