---
// Pattern generator: pick a published structure, colorway and density, crop to any format, download a PNG.
// Controls are a Tweakpane panel. Guardrails from 4.9 Usage: published colorways only, uniform scale
// (never skewed or stretched), one structure per render.
---

<div class="generator" data-generator>
  <div class="stage" data-generator-stage>
    <canvas data-generator-canvas role="img" aria-label="Pattern preview"></canvas>
    <p class="muted stage-meta" data-generator-meta aria-live="polite"></p>
  </div>
  <div class="controls" data-generator-pane></div>
</div>

<script>
  import { Pane } from 'tweakpane';
  import { colorwayFor, composePattern } from '../scripts/pattern-renderer';
  import { downloadBlob, copyText } from '../scripts/svg';
  import { notify } from '../scripts/actions';
  import {
    DENSITY_STOPS,
    colorwayNames,
    structures,
    structure as getStructure,
    type StructureId,
  } from '../data/patterns';

  const formats: Record<string, { label: string; w: number; h: number }> = {
    square: { label: 'Square 1:1', w: 2000, h: 2000 },
    portrait: { label: 'Portrait 4:5', w: 1600, h: 2000 },
    story: { label: 'Story 9:16', w: 1080, h: 1920 },
    landscape: { label: 'Landscape 16:9', w: 1920, h: 1080 },
    banner: { label: 'Banner 3:1', w: 2400, h: 800 },
    custom: { label: 'Custom', w: 1600, h: 1200 },
  };

  const root = document.querySelector<HTMLElement>('[data-generator]');
  if (root) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-generator-canvas]')!;
    const stage = root.querySelector<HTMLElement>('[data-generator-stage]')!;
    const meta = root.querySelector<HTMLElement>('[data-generator-meta]')!;

    // `density` is a stop index into DENSITY_STOPS (slits per frame).
    const state = {
      structure: 'offset' as StructureId,
      colorway: 'Forest',
      density: 3,
      format: 'square',
      width: 2000,
      height: 2000,
      rotation: 0,
      zoom: 1,
      panX: 0,
      panY: 0,
    };
    type State = typeof state;
    const defaults: State = { ...state };
    const clampSize = (v: number) => Math.min(6000, Math.max(64, Math.round(v) || 2000));

    const pane = new Pane({ container: root.querySelector<HTMLElement>('[data-generator-pane]')! });

    // Previous / next buttons beside a list, for quick switching. They step the list's own select,
    // so Tweakpane handles the change exactly as if it had been picked.
    function addSteppers(binding: { element: HTMLElement }, name: string) {
      const select = binding.element.querySelector('select')!;
      const value = binding.element.querySelector<HTMLElement>('.tp-lblv_v')!;
      const group = document.createElement('div');
      group.className = 'stepper';
      for (const [dir, label, path] of [
        [-1, 'Previous', 'M6 1 2 5l4 4'],
        [1, 'Next', 'M2 1l4 4-4 4'],
      ] as const) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'step';
        button.setAttribute('aria-label', `${label} ${name}`);
        button.innerHTML = `<svg viewBox="0 0 8 10" aria-hidden="true"><path d="${path}" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`;
        button.addEventListener('click', () => {
          const n = select.options.length;
          select.selectedIndex = (select.selectedIndex + dir + n) % n;
          select.dispatchEvent(new Event('change', { bubbles: true }));
        });
        group.append(button);
      }
      value.append(group);
      value.classList.add('has-stepper');
    }

    const pattern = pane.addFolder({ title: 'Pattern' });
    const structureBinding = pattern
      .addBinding(state, 'structure', { label: 'Structure', options: Object.fromEntries(structures.map((s) => [s.name, s.id])) })
      .on('change', () => {
        bindDensity();
        update();
      });
    addSteppers(structureBinding, 'structure');
    addSteppers(pattern.addBinding(state, 'colorway', { label: 'Colorway', options: Object.fromEntries(colorwayNames.map((n) => [n, n])) }), 'colorway');

    // Concentric is drawn from Figma's ring masks, so it only has its two densities: 10 and 20 slits
    // (stops 3 and 6). The slit structures take every stop. Tweakpane can't change a slider's range,
    // so the binding is rebuilt when the structure changes.
    let densityBinding: { dispose(): void } | undefined;
    function bindDensity() {
      const rings = state.structure === 'concentric';
      if (rings) state.density = state.density >= 5 ? 6 : 3;
      densityBinding?.dispose();
      const binding = pattern.addBinding(state, 'density', {
        label: 'Slits',
        min: rings ? 3 : 0,
        max: rings ? 6 : DENSITY_STOPS.length - 1,
        step: rings ? 3 : 1,
        format: (v) => String(DENSITY_STOPS[Math.round(v)] ?? ''),
      });
      // The field shows the slit count but would read typing as a stop index, so only the slider edits it,
      // and the count reads as plain text.
      binding.element.querySelector('input')?.setAttribute('readonly', '');
      binding.element.classList.add('value-only');
      densityBinding = binding;
    }
    bindDensity();

    const format = pane.addFolder({ title: 'Format' });
    const formatBinding = format
      .addBinding(state, 'format', { label: 'Format', options: Object.fromEntries(Object.entries(formats).map(([key, f]) => [f.label, key])) })
      .on('change', (event) => {
        if (event.value === 'custom') return;
        state.width = formats[event.value].w;
        state.height = formats[event.value].h;
        pane.refresh();
      });
    addSteppers(formatBinding, 'format');
    for (const key of ['width', 'height'] as const) {
      format.addBinding(state, key, { label: key === 'width' ? 'Width (px)' : 'Height (px)', step: 1 }).on('change', (event) => {
        let changed = false;
        const clamped = clampSize(event.value);
        if (clamped !== state[key]) {
          state[key] = clamped;
          changed = true;
        }
        // Typing a size that isn't the preset's switches the format to Custom.
        const preset = formats[state.format];
        if (state.format !== 'custom' && (preset.w !== state.width || preset.h !== state.height)) {
          state.format = 'custom';
          changed = true;
        }
        if (changed) pane.refresh();
      });
    }

    const crop = pane.addFolder({ title: 'Crop' });
    crop.addBinding(state, 'rotation', { label: 'Rotation', min: 0, max: 345, step: 15, format: (v) => `${v}°` });
    crop.addBinding(state, 'zoom', { label: 'Scale', min: 1, max: 3, step: 0.05, format: (v) => `${Math.round(v * 100)}%` });
    crop.addBinding(state, 'panX', { label: 'Position X', min: -1, max: 1, step: 0.01, format: (v) => v.toFixed(2) });
    crop.addBinding(state, 'panY', { label: 'Position Y', min: -1, max: 1, step: 0.01, format: (v) => v.toFixed(2) });

    pane.addButton({ title: 'Download PNG' }).on('click', download);
    pane.addButton({ title: 'Copy link' }).on('click', async () => {
      await copyText(`${location.origin}${location.pathname}#pattern-generator?${serialize()}`);
      notify('Link copied');
    });
    pane.addButton({ title: 'Reset' }).on('click', () => {
      Object.assign(state, defaults);
      bindDensity();
      pane.refresh();
      update();
    });

    pane.on('change', update);

    function serialize() {
      return new URLSearchParams(Object.entries(state).map(([k, v]) => [k, String(v)])).toString();
    }

    function apply(params: URLSearchParams) {
      const s = state as Record<string, string | number>;
      for (const [k, v] of params) {
        if (!(k in s)) continue;
        s[k] = typeof s[k] === 'number' ? Number(v) || 0 : v;
      }
      state.width = clampSize(state.width);
      state.height = clampSize(state.height);
      if (!structures.some((x) => x.id === state.structure)) state.structure = defaults.structure;
      if (!colorwayNames.includes(state.colorway as never)) state.colorway = defaults.colorway;
      if (!(state.format in formats)) state.format = 'custom';
      state.density = Math.min(DENSITY_STOPS.length - 1, Math.max(0, Math.round(state.density)));
    }

    /** Renderer options for the current density stop. */
    function fieldDensity() {
      if (state.structure === 'concentric') return { density: state.density >= 6 ? 2 : 1 };
      return { density: 1, slits: DENSITY_STOPS[state.density] };
    }

    const renderOptions = (width: number, height: number) => ({
      structure: state.structure,
      ...fieldDensity(),
      colors: colorwayFor(state.structure, state.colorway),
      width,
      height,
      rotation: state.rotation,
      zoom: state.zoom,
      panX: state.panX,
      panY: state.panY,
    });

    let frame = 0;
    let token = 0;
    async function render() {
      const ratio = state.width / state.height;
      const maxW = stage.getBoundingClientRect().width;
      const maxH = Math.min(window.innerHeight * 0.7, 640);
      let w = maxW;
      let h = w / ratio;
      if (h > maxH) {
        h = maxH;
        w = h * ratio;
      }
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const mine = ++token;
      const off = document.createElement('canvas');
      await composePattern(off, renderOptions(Math.round(w * dpr), Math.round(h * dpr)));
      if (mine !== token) return; // a newer render started
      canvas.width = off.width;
      canvas.height = off.height;
      canvas.getContext('2d')!.drawImage(off, 0, 0);
      meta.textContent = `${getStructure(state.structure).name} · ${state.colorway} · ${DENSITY_STOPS[state.density]} slits · ${state.width} × ${state.height} px`;
    }

    function schedule() {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => void render());
    }

    function update() {
      history.replaceState(null, '', `#pattern-generator?${serialize()}`);
      schedule();
    }

    async function download() {
      const s = { ...state };
      notify('Rendering PNG…');
      const out = document.createElement('canvas');
      await composePattern(out, renderOptions(s.width, s.height));
      out.toBlob((blob) => {
        if (!blob) return notify('Export failed');
        const name = `atomsai-pattern-${s.structure}-${s.colorway.toLowerCase()}-${DENSITY_STOPS[s.density]}-slits-${s.width}x${s.height}.png`;
        downloadBlob(blob, name);
        notify('PNG downloaded');
      }, 'image/png');
    }

    // Restore settings from a shared link.
    const hash = location.hash.match(/^#pattern-generator\?(.+)$/);
    if (hash) {
      apply(new URLSearchParams(hash[1]));
      bindDensity();
      pane.refresh();
      document.getElementById('pattern-generator')?.scrollIntoView();
    }
    schedule();
    new ResizeObserver(schedule).observe(stage);
  }
</script>

<style>
  /* Preview on the left, the panel on the right. */
  .generator {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
    gap: var(--gutter);
    align-items: start;
  }

  /* Tweakpane, themed with brand tokens: pill-shaped controls, PP Neue Montreal, quiet tints.
     Lists and buttons share Tweakpane's button colors, so both use the input tint. */
  .controls {
    --tp-base-background-color: var(--white);
    --tp-base-shadow-color: transparent;
    --tp-base-border-radius: 0;
    --tp-base-font-family: var(--font-text);
    --tp-blade-border-radius: 999px;
    --tp-container-unit-size: 28px;
    --tp-blade-value-width: 60%;
    --tp-blade-horizontal-padding: 10px;
    --tp-container-horizontal-padding: 0;
    --tp-container-vertical-padding: 0.5rem;
    --tp-container-unit-spacing: 6px;
    --tp-container-background-color: transparent;
    --tp-container-background-color-hover: color-mix(in srgb, var(--deep-green) 4%, transparent);
    --tp-container-background-color-focus: color-mix(in srgb, var(--deep-green) 6%, transparent);
    --tp-container-background-color-active: color-mix(in srgb, var(--deep-green) 8%, transparent);
    --tp-container-foreground-color: var(--fg);
    --tp-label-foreground-color: var(--muted);
    --tp-input-background-color: color-mix(in srgb, var(--deep-green) 6%, transparent);
    --tp-input-background-color-hover: color-mix(in srgb, var(--deep-green) 9%, transparent);
    --tp-input-background-color-focus: color-mix(in srgb, var(--deep-green) 11%, transparent);
    --tp-input-background-color-active: color-mix(in srgb, var(--deep-green) 13%, transparent);
    --tp-input-foreground-color: var(--fg);
    --tp-groove-foreground-color: color-mix(in srgb, var(--deep-green) 14%, transparent);
    --tp-button-background-color: color-mix(in srgb, var(--deep-green) 6%, transparent);
    --tp-button-background-color-hover: color-mix(in srgb, var(--deep-green) 9%, transparent);
    --tp-button-background-color-focus: color-mix(in srgb, var(--deep-green) 11%, transparent);
    --tp-button-background-color-active: color-mix(in srgb, var(--deep-green) 13%, transparent);
    --tp-button-foreground-color: var(--fg);
  }

  .controls :global(.tp-rotv) {
    font-size: var(--size-annotation);
  }

  /* Tweakpane sets lists and buttons in bold; keep them at the regular weight. */
  .controls :global(.tp-lstv_s),
  .controls :global(.tp-btnv_b) {
    font-weight: 400;
  }

  /* Number fields are typed into, not dragged: drop Tweakpane's scrub handle, so the slider is
     the only thing that slides. */
  .controls :global(.tp-txtv_k) {
    display: none;
  }

  .controls :global(.value-only .tp-txtv_i) {
    padding-right: 0;
    background: none;
    cursor: default;
  }

  /* Folder toggle: a chevron at the right, pointing right when closed and down when open. */
  .controls :global(.tp-fldv_b) {
    position: relative;
  }

  .controls :global(.tp-fldv_m) {
    left: auto;
    right: 6px;
    width: 6px;
    height: 6px;
    background: none;
    border-radius: 0;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    opacity: 0.6;
    transform: rotate(-45deg);
  }

  .controls :global(.tp-fldv.tp-fldv-expanded > .tp-fldv_b > .tp-fldv_m) {
    transform: translateY(-2px) rotate(45deg);
  }

  /* Previous / next buttons beside each list. */
  .controls :global(.has-stepper) {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .controls :global(.has-stepper > .tp-lstv) {
    flex: 1;
    min-width: 0;
  }

  .controls :global(.stepper) {
    display: flex;
    gap: 4px;
  }

  .controls :global(.step) {
    display: grid;
    place-items: center;
    width: var(--tp-container-unit-size);
    height: var(--tp-container-unit-size);
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--tp-button-background-color);
    color: var(--fg);
    cursor: pointer;
  }

  .controls :global(.step:hover) {
    background: var(--tp-button-background-color-hover);
  }

  .controls :global(.step:active) {
    background: var(--tp-button-background-color-active);
  }

  .controls :global(.step svg) {
    width: 8px;
    height: 10px;
  }

  /* Slider knobs use the button color, which is a light tint here; keep them solid. */
  .controls :global(.tp-sldv_k::after),
  .controls :global(.tp-sldv_t:hover .tp-sldv_k::after),
  .controls :global(.tp-sldv_t:focus .tp-sldv_k::after),
  .controls :global(.tp-sldv_t:active .tp-sldv_k::after) {
    background-color: var(--deep-green);
  }

  .stage {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    min-width: 0;
    position: sticky;
    top: var(--gutter);
  }

  .stage canvas {
    display: block;
    max-width: 100%;
    background: var(--forest-shade);
  }

  @media (max-width: 1100px) {
    .generator {
      grid-template-columns: minmax(0, 1fr);
    }

    .stage {
      position: static;
    }
  }
</style>
