---
import ChartSpecimen from './ChartSpecimen.astro';
import { colors } from '../data/colors';

// Fictional values for demonstrating composition, not company performance.
const automated = 59;
const angle = automated / 100 * Math.PI * 2 - Math.PI / 2;
const spend = [{ name: 'Automated', value: 2.4 }, { name: 'Manual', value: 11.1 }];
const totalSpend = spend.reduce((sum, item) => sum + item.value, 0);
const adoption = [
  { name: 'Support', value: 72, radius: 104, color: 'irisDark' },
  { name: 'Operations', value: 64, radius: 80, color: 'iris' },
  { name: 'Finance', value: 48, radius: 56, color: 'forestGreen' },
] as const;
const volume = [
  { name: 'Support', value: 854 }, { name: 'Sales', value: 560 },
  { name: 'Ops', value: 313 }, { name: 'Finance', value: 171 },
];
const growth = [
  { year: 2024, value: 2.4 }, { year: 2025, value: 2.7 }, { year: 2026, value: 3.2 },
];
---

<div class="editorial-gallery">
  <div class="editorial-examples">
    <ChartSpecimen id="editorial-progress" label="Radial statistic" background="irisLight" foreground="irisDark">
      <div class="editorial-canvas progress" role="img" aria-label="59% of requests automated. A circular arc covers 59% of a full turn. Illustrative data.">
        <p class="eyebrow">Requests automated</p>
        <div class="progress-ring" aria-hidden="true">
          <svg viewBox="0 0 260 260">
            <circle class="ring-track" cx="130" cy="130" r="110" />
            <circle class="ring-progress" cx="130" cy="130" r="110" pathLength="100" stroke-dasharray={`${automated} ${100 - automated}`} transform="rotate(-90 130 130)" />
            <circle cx={130 + 110 * Math.cos(angle)} cy={130 + 110 * Math.sin(angle)} r="3" fill="currentColor" />
          </svg>
          <div class="metric ring-metric">59<span class="suffix">%</span></div>
        </div>
      </div>
    </ChartSpecimen>

    <ChartSpecimen id="editorial-split" label="Proportional spend split" background="deepGreen" foreground="paper">
      <div class="editorial-canvas split" role="img" aria-label="13.5 million dollars in annual operating spend. Automated: 2.4 million, 18%. Manual: 11.1 million, 82%. Column widths represent the exact shares. Illustrative data.">
        <div aria-hidden="true"><p class="metric"><span class="prefix">$</span>13.5<span class="suffix">M</span></p><p class="eyebrow">Annual operating spend</p></div>
        <div class="split-columns" style={`grid-template-columns:${spend.map(item => `${item.value}fr`).join(' ')}`} aria-hidden="true">
          {spend.map(item => <div class="split-column"><span class="small-value">${item.value}M</span><div class="split-caption"><span>{Math.round(item.value / totalSpend * 100)}%</span><span class="split-name">{item.name}</span><span class="split-name-short">{item.name === 'Automated' ? 'Auto.' : item.name}</span></div></div>)}
        </div>
        <div class="tick-strip" aria-hidden="true">{Array.from({length:100}, () => <span />)}</div>
      </div>
    </ChartSpecimen>

    <ChartSpecimen id="editorial-radial" label="Concentric completion rates" background="paper" foreground="deepGreen">
      <div class="editorial-canvas radial" role="img" aria-label="Workflow adoption by team. Support 72%, Operations 64%, Finance 48%. Each ring uses a full turn for 100%. Illustrative data.">
        <p class="statement">One workflow.<br />Three teams.</p>
        <div class="radial-body" aria-hidden="true">
          <ul class="radial-key">{adoption.map(item => <li><span class="key-mark" style={`background:${colors[item.color].hex}`} /><div><span>{item.name}</span><strong>{item.value}%</strong></div></li>)}</ul>
          <svg viewBox="0 0 240 240">
            {adoption.map(item => <g fill="none" stroke={colors[item.color].hex} stroke-width="13">
              <circle cx="120" cy="120" r={item.radius} opacity="0.1" />
              <circle cx="120" cy="120" r={item.radius} pathLength="100" stroke-dasharray={`${item.value} ${100-item.value}`} transform="rotate(-90 120 120)" />
            </g>)}
          </svg>
        </div>
      </div>
    </ChartSpecimen>

    <ChartSpecimen id="editorial-ranked" label="Ranked request volumes" background="irisLight" foreground="irisDark">
      <div class="editorial-canvas ranked" role="img" aria-label="1.898 million monthly requests. Support 854 thousand, Sales 560 thousand, Operations 313 thousand, Finance 171 thousand. Columns share a zero baseline. Illustrative data.">
        <div class="ranked-heading" aria-hidden="true"><p class="metric">1.898<span class="suffix">M</span></p><p class="eyebrow">Monthly requests</p></div>
        <div class="ranked-columns" aria-hidden="true">
          {volume.map(item => <div class="ranked-column"><div class="column-label"><span>{item.name}</span><span>{item.value}k</span></div><span class="ranked-bar" style={`height:${item.value / 900 * 100}%`} /></div>)}
        </div>
      </div>
    </ChartSpecimen>

    <ChartSpecimen id="editorial-growth" label="Stepped annual growth" background="paper" foreground="deepGreen">
      <div class="editorial-canvas growth" role="img" aria-label="800 thousand more tasks completed. 2024: 2.4 million. 2025: 2.7 million. 2026: 3.2 million. Steps use a zero baseline and a shared scale. Illustrative data.">
        <div class="growth-heading" aria-hidden="true"><p class="eyebrow">More tasks<br />completed</p><p class="metric">800<span class="suffix">k</span></p></div>
        <div class="growth-columns" aria-hidden="true">
          {growth.map(item => <div class="growth-column"><span class="year">{item.year}</span><div class="growth-step" style={`height:${item.value / 3.5 * 100}%`}><span>{item.value.toFixed(1)}M</span></div></div>)}
        </div>
      </div>
    </ChartSpecimen>

    <ChartSpecimen id="editorial-ratio" label="One in five circle ratio" background="forestShade" foreground="paper">
      <div class="editorial-canvas ratio" role="img" aria-label="20% of requests need a human decision. One of five equal circles is filled, four are hatched. Illustrative data.">
        <div aria-hidden="true"><p class="metric">20<span class="suffix">%</span></p><p class="statement">One in five requests<br />needs a human decision.</p></div>
        <div class="ratio-circles" aria-hidden="true">{Array.from({length:5}, (_,i) => <span class:list={['ratio-circle', {selected:i===0}]} />)}</div>
      </div>
    </ChartSpecimen>
  </div>
</div>

<style>
  .editorial-gallery { container-type: inline-size; }
  .editorial-examples { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem 1.5rem; }
  .editorial-canvas { height:clamp(18rem,64cqi,23rem); min-width:0; display:flex; flex-direction:column; }
  .metric { font-family:var(--font-display); font-size:clamp(3.75rem,22cqi,7.5rem); font-weight:400; letter-spacing:-0.015em; line-height:0.9; white-space:nowrap; }
  .suffix,.prefix { font-size:0.48em; vertical-align:top; line-height:1.25; }
  .eyebrow { font-size:var(--size-annotation); line-height:1.25; }
  .metric + .eyebrow { margin-top:0.75rem; }
  .statement { font-family:var(--font-display); font-size:clamp(1.5rem,6cqi,2rem); font-weight:400; line-height:0.95; letter-spacing:-0.015em; }
  svg { display:block; width:100%; height:100%; }
  .progress-ring { position:relative; align-self:center; flex:1; min-height:0; width:min(100%,19rem); }
  .progress-ring svg { padding:0.5rem; }
  .ring-track,.ring-progress { fill:none; stroke:currentColor; stroke-width:1; }
  .ring-track { stroke-dasharray:1 7; opacity:0.3; }
  .ring-metric { position:absolute; inset:0; display:flex; justify-content:center; align-items:center; }
  .ring-metric .suffix { align-self:center; transform:translateY(-0.4em); }
  .split-columns { display:grid; flex:1; margin-top:3rem; min-width:0; }
  .split-column { display:flex; flex-direction:column; justify-content:space-between; min-width:0; padding:0 0.5rem; border-left:1px solid color-mix(in srgb,currentColor 30%,transparent); }
  .small-value { font-size:clamp(0.875rem,3.5cqi,1.25rem); line-height:1; white-space:nowrap; }
  .split-caption { display:grid; font-size:var(--size-annotation-small); line-height:1.2; gap:0.25rem; padding-bottom:0.75rem; }
  .split-name-short { display:none; }
  .tick-strip { display:flex; height:0.875rem; justify-content:space-between; }
  .tick-strip span { border-left:1px solid currentColor; opacity:0.4; }
  .radial-body { display:grid; grid-template-columns:minmax(0,0.8fr) minmax(0,1.2fr); align-items:end; flex:1; gap:1rem; }
  .radial-body svg { height:auto; align-self:center; }
  .radial-key { display:grid; gap:1rem; list-style:none; padding:0; font-size:var(--size-annotation-small); }
  .radial-key li { display:flex; gap:0.5rem; align-items:start; }
  .key-mark { width:0.5rem; height:0.5rem; flex:none; margin-top:0.25rem; }
  .radial-key li div { display:grid; gap:0.125rem; }
  .radial-key strong { font-size:var(--size-annotation); font-weight:400; }
  .ranked { display:grid; grid-template-columns:minmax(0,0.9fr) minmax(0,1.1fr); gap:1rem; }
  .ranked .metric { font-size:clamp(2.5rem,13cqi,4.5rem); }
  .ranked-columns { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); min-width:0; }
  .ranked-column { position:relative; display:flex; align-items:end; border-left:1px solid color-mix(in srgb,currentColor 12%,transparent); padding-top:3.5rem; }
  .column-label { position:absolute; top:0; left:0.3rem; display:grid; gap:0.25rem; font-size:clamp(0.625rem,2.2cqi,0.75rem); line-height:1.1; }
  .ranked-bar { width:100%; background:currentColor; }
  .growth-heading { display:flex; justify-content:space-between; gap:1rem; align-items:start; }
  .growth .metric { color:var(--iris-dark); }
  .growth-columns { flex:1; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin-top:2.5rem; }
  .growth-column { display:flex; align-items:end; position:relative; padding-top:2rem; border-left:1px solid color-mix(in srgb,currentColor 12%,transparent); }
  .year { position:absolute; top:0; left:0.5rem; font-size:var(--size-annotation-small); }
  .growth-step { width:100%; background:color-mix(in srgb,var(--iris-light) 25%,transparent); border-top:1px solid currentColor; padding:0.5rem; font-size:var(--size-annotation); line-height:1; }
  .ratio { justify-content:space-between; }
  .ratio .statement { margin-top:1rem; max-width:18ch; }
  .ratio-circles { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:0.5rem; }
  .ratio-circle { aspect-ratio:1; border:1px solid color-mix(in srgb,currentColor 40%,transparent); border-radius:50%; background:repeating-linear-gradient(45deg,transparent 0 5px,color-mix(in srgb,currentColor 35%,transparent) 5px 6px); }
  .ratio-circle.selected { background:var(--iris); border-color:var(--iris); }
  @container (max-width:660px) { .editorial-examples { grid-template-columns:minmax(0,1fr); } }
  @container (max-width:360px) {
    .ranked { grid-template-columns:minmax(0,1fr); grid-template-rows:auto minmax(0,1fr); gap:1.5rem; }
    .ranked .metric { font-size:clamp(2.5rem,20cqi,4rem); }
    .column-label { font-size:0.75rem; }
    .ranked-column { padding-top:2.5rem; }
    .split-columns { margin-top:2rem; }
    .split-column { padding-inline:0.25rem; }
    .small-value { font-size:0.75rem; }
    .split-name { display:none; }
    .split-name-short { display:block; }
  }
</style>
