---
// One skill's page body, in two sub-sections like the guideline pages: an intro set from the
// skill's frontmatter (when to use it as a statement, then its facts), and the skill file itself,
// with Preview / Markdown tabs, copy and download, and only the reader framed.
import type { BrandSkill } from '../data/skills';
import Sub from './Sub.astro';

interface Props { skill: BrandSkill }
const { skill } = Astro.props;
const html = await skill.previewHtml();

const facts = [
  { label: 'Skill', value: skill.name },
  { label: 'Version', value: skill.metadata.version },
  { label: 'Reviewed', value: skill.metadata.reviewed },
  { label: 'File', value: `SKILL.md · ${(skill.bytes / 1024).toFixed(1)} KB` },
];
---

<div class="skill" data-skill-card>
  <Sub id="about" title="About this skill" quiet>
    <p class="statement balance">{skill.description}</p>
    <dl class="facts">
      {
        facts.map((f) => (
          <div>
            <dt class="muted">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
      <div class="covers">
        <dt class="muted">Covers</dt>
        <dd>
          <ul aria-label="Included topics">{skill.covers.map((topic) => <li>{topic}</li>)}</ul>
        </dd>
      </div>
    </dl>
  </Sub>

  <Sub id="skill-file" title="Skill file">
    <div class="bar">
      <div class="tabs" role="tablist" aria-label={`${skill.title} view`} data-skill-tabs hidden>
        <button class="btn" type="button" role="tab" id={`${skill.slug}-preview-tab`} aria-controls={`${skill.slug}-preview-panel`} aria-selected="true" data-skill-tab="preview">Preview</button>
        <button class="btn" type="button" role="tab" id={`${skill.slug}-source-tab`} aria-controls={`${skill.slug}-source-panel`} aria-selected="false" tabindex="-1" data-skill-tab="source">Markdown</button>
      </div>
      <div class="btn-row">
        <button class="btn" type="button" data-copy-skill hidden aria-label={`Copy ${skill.title} Markdown`}>Copy to clipboard</button>
        <a class="btn" href={skill.download} download={skill.filename} aria-label={`Download ${skill.title} as Markdown`}>Download .md ↓</a>
      </div>
    </div>
    <p class="copy-status muted" role="status" aria-live="polite" data-skill-status></p>
    <div class="reader markdown" id={`${skill.slug}-preview-panel`} tabindex="0" role="region" aria-label={`${skill.title} formatted preview`} data-skill-panel="preview">
      <div set:html={html} />
    </div>
    <div class="reader source" id={`${skill.slug}-source-panel`} tabindex="0" role="region" aria-label={`${skill.title} Markdown source`} data-skill-panel="source" hidden>
      <pre><code>{skill.markdown}</code></pre>
    </div>
    <textarea hidden readonly aria-label={`${skill.title} copy source`} data-skill-source>{skill.markdown}</textarea>
  </Sub>
</div>

<script>
  import { copyText } from '../scripts/svg';

  document.querySelectorAll<HTMLElement>('[data-skill-card]').forEach((card) => {
    const copy = card.querySelector<HTMLButtonElement>('[data-copy-skill]')!;
    const source = card.querySelector<HTMLTextAreaElement>('[data-skill-source]')!;
    const status = card.querySelector<HTMLElement>('[data-skill-status]')!;
    const tabs = [...card.querySelectorAll<HTMLButtonElement>('[data-skill-tab]')];
    const panels = [...card.querySelectorAll<HTMLElement>('[data-skill-panel]')];
    copy.hidden = false;
    card.querySelector<HTMLElement>('[data-skill-tabs]')!.hidden = false;
    panels.forEach((panel, index) => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[index].id);
    });

    copy.addEventListener('click', async () => {
      copy.disabled = true;
      try {
        await copyText(source.value);
        status.textContent = 'Markdown copied. Ready for your agent.';
      } catch {
        status.textContent = 'Couldn’t copy. Download the .md file or select the Markdown text.';
      } finally {
        copy.disabled = false;
      }
    });

    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((item) => {
        const active = item === tab;
        item.setAttribute('aria-selected', String(active));
        item.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.skillPanel !== tab.dataset.skillTab; });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        let next: number;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(tabs[next]);
        tabs[next].focus();
      });
    });
  });
</script>

<style>
  /* Intro: when to use the skill, set large like the guide's statement, then its facts. */
  .statement {
    padding-bottom: 0.22em;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    line-height: 0.95;
    letter-spacing: -0.015em;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.75rem var(--gutter);
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .facts > div {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .facts dd {
    overflow-wrap: anywhere;
  }

  .covers {
    grid-column: 1 / -1;
  }

  .covers ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  /* Skill file: tabs on the left, copy and download on the right, then the framed reader. */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1rem;
  }

  .tabs {
    display: flex;
    gap: 0.5rem;
  }

  .tabs [aria-selected='true'] {
    background: var(--deep-green);
    color: var(--cream);
    border-color: var(--deep-green);
  }

  .copy-status {
    margin-bottom: 1rem;
  }

  .copy-status:empty {
    display: none;
  }

  .reader {
    overflow-x: auto;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    box-shadow: inset 0 0 0 1px var(--rule);
    scrollbar-gutter: stable;
  }

  .reader:focus-visible { outline-offset: -3px; }
  .reader, .reader :global(*) { text-box: normal; }

  /* Markdown headings arrive as h3 (the skill's title) and down, under the page and section titles. */
  .markdown { line-height: 1.6; overflow-wrap: anywhere; }
  .markdown :global(h3), .markdown :global(h4), .markdown :global(h5), .markdown :global(h6) { font-family: var(--font-display); font-size: var(--size-display); font-weight: 400; letter-spacing: -0.015em; line-height: 1; margin: 2.5rem 0 1.25rem; }
  .markdown :global(h3:first-child) { margin-top: 0; }
  .markdown :global(h5), .markdown :global(h6) { font-family: var(--font-text); font-size: var(--size-annotation); font-weight: 500; letter-spacing: 0; line-height: 1.4; margin-top: 1.75rem; }
  .markdown :global(p), .markdown :global(ul), .markdown :global(ol), .markdown :global(pre), .markdown :global(.table-scroll) { margin-bottom: 1.25rem; }
  .markdown :global(ul), .markdown :global(ol) { padding-left: 1.5rem; }
  .markdown :global(ul) { list-style: disc; }
  .markdown :global(ol) { list-style: decimal; }
  .markdown :global(li + li) { margin-top: 0.5rem; }
  .markdown :global(strong) { font-weight: 500; }
  .markdown :global(.table-scroll) { overflow-x: auto; }
  .markdown :global(table) { width: 100%; border-collapse: collapse; font-size: inherit; }
  .markdown :global(th), .markdown :global(td) { padding: 0.75rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); min-width: 8rem; }
  .markdown :global(th) { font-weight: 500; background: var(--deep-green); color: var(--cream); border-bottom-color: var(--deep-green); }
  .markdown :global(pre) { overflow-x: auto; padding: 1rem; border: 1px solid var(--rule); }
  .markdown :global(code), .source code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.875em; }
  .markdown :global(pre), .markdown :global(pre span) { background: var(--paper) !important; color: var(--fg) !important; }
  .markdown :global(pre code) { white-space: pre; }
  .source pre { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.6; }

  /* Scoped layout rules must not override the native hidden attribute. */
  [hidden] { display: none !important; }

  @media (max-width: 760px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
