---
// The stage, settings panel and hint for a full-viewport canvas tool (used with layouts/Canvas).
// The page's own script mounts into [data-canvas-stage] and [data-canvas-pane].

interface Props {
  /** Accessible name for the canvas. */
  label: string;
  /** The view can be dragged to orbit (3D tools); flat tools set this to false. */
  orbit?: boolean;
}

const { label, orbit = true } = Astro.props;
---

<main class="canvas-tool">
  <div class:list={['stage', { orbit }]} data-canvas-stage aria-label={label} role="img"></div>
  <aside class="panel tp-theme" data-canvas-pane aria-label={`${label} settings`}></aside>
  <p class="hint">{orbit ? 'Drag to orbit · H shows or hides the panel' : 'H shows or hides the panel'}</p>
</main>

<style>
  .canvas-tool {
    position: fixed;
    inset: 0;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  .stage.orbit {
    cursor: grab;
    touch-action: none;
  }

  .stage.orbit:active {
    cursor: grabbing;
  }

  .stage :global(canvas) {
    display: block;
  }

  /* Tweakpane floats over the canvas on its own white surface (the .tp-theme is a light theme). */
  .panel {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 21rem;
    max-height: calc(100% - 2rem);
    overflow-y: auto;
    padding: 0.25rem 0.75rem;
    background: var(--white);
    color: var(--fg);
  }

  .panel[hidden] {
    display: none;
  }

  .hint {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    color: color-mix(in srgb, var(--canvas-fg) 60%, transparent);
    font-size: var(--size-annotation-small);
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .panel {
      top: auto;
      bottom: 0;
      right: 0;
      left: 0;
      width: auto;
      max-height: 50%;
    }

    .hint {
      display: none;
    }
  }
</style>
