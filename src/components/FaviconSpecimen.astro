---
import { withBase } from '../data/base';
import { faviconFiles, faviconMarkup } from '../data/favicon';
import { icon } from '../data/icons';
---

<div class="favicon-kit">
  <div class="bar">
    <p>Browser preview</p>
    <a class="btn" href={withBase('/assets/favicon.zip')} download="atomsai-favicon-kit.zip">Download favicon kit ↓</a>
  </div>
  <div class="style-options" role="group" aria-label="Favicon preview style" data-favicon-options hidden>
    <button class="btn" type="button" data-favicon-style="transparent" aria-pressed="true">Transparent · full size</button>
    <button class="btn" type="button" data-favicon-style="background" aria-pressed="false">Deep green background</button>
  </div>
  {['transparent', 'background'].map((style) => (
    <div class="previews" data-favicon-preview={style}>
    {['light', 'dark'].map((tone) => {
      const prefix = style === 'background' ? 'favicon' : `favicon-transparent-${tone === 'light' ? 'deep-green' : 'cream'}`;
      return (
      <figure class:list={['browser', tone]}>
        <div class="tab">
          <img src={withBase(`/${prefix}.svg`)} width="16" height="16" alt="" />
          <span>AtomsAI — Brand</span>
          <span class="close" set:html={icon('close')} aria-hidden="true" />
        </div>
        <div class="sizes">
          {[16, 32, 48].map((size) => (
            <div class="sample">
              <span class="sample-image"><img src={withBase(`/${prefix}-${size}x${size}.png`)} width={size} height={size} alt={`${style === 'transparent' ? 'Transparent' : 'Deep green background'} AtomsAI favicon at ${size} pixels`} /></span>
              <span>{size} px</span>
            </div>
          ))}
        </div>
        <figcaption>{style === 'transparent' ? `${tone === 'light' ? 'Deep green' : 'Cream'} mark · transparent` : 'Cream mark · Deep green background'}</figcaption>
      </figure>
    ); })}
    </div>
  ))}
  <details class="file-downloads">
    <summary>Individual files ({faviconFiles.length})</summary>
    <ul class="files" aria-label="Favicon files">
    {faviconFiles.map(({ file, label, detail }) => (
      <li>
        <div><p>{label}</p><p class="muted">{detail}</p></div>
        <a class="btn" href={withBase(file)} download={file.slice(1)} aria-label={`Download ${label}, ${detail}`}>Download ↓</a>
      </li>
    ))}
    </ul>
  </details>
  <details class="setup">
    <summary>Website setup</summary>
    <div class="setup-body">
      <p>Place the files in your site’s public root, then add these lines inside <code>&lt;head&gt;</code>. For a site in a subdirectory, prefix each path with that base.</p>
      <pre tabindex="0" aria-label="Favicon HTML"><code data-favicon-markup>{faviconMarkup}</code></pre>
      <div class="bar">
        <button class="btn" type="button" data-copy-favicon hidden>Copy HTML</button>
        <p class="muted" role="status" aria-live="polite" data-favicon-status></p>
      </div>
      <p class="muted">This setup uses the solid background. For a transparent favicon, use the matching transparent SVG and ICO filenames and choose an ink that contrasts with the browser surface. Keep the Apple touch icon on its solid background.</p>
    </div>
  </details>
</div>

<script>
  import { copyText } from '../scripts/svg';
  const styles = [...document.querySelectorAll<HTMLButtonElement>('[data-favicon-style]')];
  const previews = [...document.querySelectorAll<HTMLElement>('[data-favicon-preview]')];
  const selectStyle = (style: string) => {
    styles.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.faviconStyle === style)));
    previews.forEach((preview) => { preview.hidden = preview.dataset.faviconPreview !== style; });
  };
  document.querySelector<HTMLElement>('[data-favicon-options]')!.hidden = false;
  selectStyle('transparent');
  styles.forEach((button) => button.addEventListener('click', () => selectStyle(button.dataset.faviconStyle!)));
  const copy = document.querySelector<HTMLButtonElement>('[data-copy-favicon]');
  if (copy) {
    copy.hidden = false;
    copy.addEventListener('click', async () => {
      const status = document.querySelector<HTMLElement>('[data-favicon-status]')!;
      try {
        await copyText(document.querySelector('[data-favicon-markup]')!.textContent ?? '');
        status.textContent = 'HTML copied.';
      } catch {
        status.textContent = 'Couldn’t copy. Select the HTML above or use the README in the kit.';
      }
    });
  }
</script>

<style>
  .favicon-kit { display: grid; gap: 1.5rem; min-width: 0; }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .style-options { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .style-options [aria-pressed='true'] { background: var(--deep-green); color: var(--cream); border-color: var(--deep-green); }
  .previews { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .browser { padding: 1.25rem; border: 1px solid var(--rule); background: var(--paper); color: var(--deep-green); min-width: 0; }
  .browser.dark { background: var(--forest-shade); color: var(--cream); }
  .tab { display: flex; align-items: center; gap: 0.625rem; padding: 0.875rem; border-radius: 0.5rem 0.5rem 0 0; background: var(--white); }
  .dark .tab { background: var(--charcoal); }
  .tab > span:not(.close) { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .tab img { flex: none; }
  .close { display: block; width: 0.875rem; height: 0.875rem; margin-left: auto; flex: none; }
  .close :global(svg) { display: block; width: 100%; height: 100%; }
  .sizes { display: flex; justify-content: space-around; gap: 0.75rem; padding: 2rem 0; }
  .sample { display: grid; justify-items: center; gap: 0.75rem; }
  .sample-image { display: grid; place-items: center; height: 3rem; }
  .sample img { display: block; }
  figcaption { opacity: 0.8; line-height: 1.4; }
  .files { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.5rem; padding: 0 1.25rem 1.25rem; }
  .files li { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .files li > div { display: grid; gap: 0.5rem; }
  .files .btn { flex: none; }
  .setup, .file-downloads { border: 1px solid var(--rule); }
  summary { cursor: pointer; padding: 1.25rem; }
  .setup-body { display: grid; gap: 1rem; padding: 0 1.25rem 1.25rem; }
  pre { max-width: 100%; overflow-x: auto; margin: 0; padding: 1rem; background: var(--paper); line-height: 1.6; }
  code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.875em; }
  pre, code { text-box: normal; }
  [hidden] { display: none !important; }
  @media (max-width: 680px) { .previews, .files { grid-template-columns: minmax(0, 1fr); } }
</style>
